---
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
import Layout from "../layouts/Layout.astro";

// Data Pengurus Badan Pengurus Harian (BPH)
const leadership = {
  ketua: {
    role: "Ketua Umum",
    roleCode: "BPH-01",
    roleBadgeClass: "bg-primary text-white",
    name: "Arya Bima Prakosa",
    rimbaName: "Elang Wana",
    nik: "TNB.XXIX.24.001",
    angkatan: "Angkatan 29 - Kirana Arutala",
    photo: "https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=400&q=80",
    quote: "Teguh menjaga panji rimba, memimpin dengan aksi nyata dan keteladanan.",
    socials: {
      instagram: "https://instagram.com",
      linkedin: "https://linkedin.com",
      whatsapp: "https://wa.me/6281200000001",
    },
  },
  wakil: {
    role: "Wakil Ketua Umum",
    roleCode: "BPH-02",
    roleBadgeClass: "bg-secondary text-white",
    name: "Fajar Satria Ramadhan",
    rimbaName: "Kabut Rimba",
    nik: "TNB.XXIX.24.002",
    angkatan: "Angkatan 29 - Kirana Arutala",
    photo: "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=400&q=80",
    quote: "Menyelaraskan koordinasi divisi demi kesiapan operasional lapangan yang matang.",
    socials: {
      instagram: "https://instagram.com",
      linkedin: "https://linkedin.com",
      whatsapp: "https://wa.me/6281200000002",
    },
  },
};

const staffMembers = [
  {
    role: "Sekretaris Umum",
    roleCode: "BPH-03",
    roleBadgeClass: "bg-[#065143] text-white",
    name: "Nabila Putri Anggraini",
    rimbaName: "Embun Pagi",
    nik: "TNB.XXX.24.008",
    angkatan: "Angkatan 30 - Taranggana Prabaswara",
    photo: "https://images.unsplash.com/photo-1494790108377-be9c29b29330?auto=format&fit=crop&w=400&q=80",
    desc: "Pengelolaan tata kelola persuratan resmi, arsip ekspedisi, dan administrasi keanggotaan.",
    socials: {
      instagram: "https://instagram.com",
      linkedin: "https://linkedin.com",
      whatsapp: "https://wa.me/6281200000003",
    },
  },
  {
    role: "Bendahara Umum",
    roleCode: "BPH-04",
    roleBadgeClass: "bg-[#FF8000] text-white",
    name: "Dimas Raka Pratama",
    rimbaName: "Batu Karang",
    nik: "TNB.XXX.24.012",
    angkatan: "Angkatan 30 - Taranggana Prabaswara",
    photo: "https://images.unsplash.com/photo-1500648767791-00dcc994a43e?auto=format&fit=crop&w=400&q=80",
    desc: "Akuntabilitas anggaran operasional, dana kas ekspedisi, dan logistik perbendaharaan.",
    socials: {
      instagram: "https://instagram.com",
      linkedin: "https://linkedin.com",
      whatsapp: "https://wa.me/6281200000004",
    },
  },
  {
    role: "Hubungan Masyarakat (Humas)",
    roleCode: "BPH-05",
    roleBadgeClass: "bg-teal-700 text-white",
    name: "Rizky Fauzan Hidayat",
    rimbaName: "Sinar Surya",
    nik: "TNB.XXX.24.015",
    angkatan: "Angkatan 30 - Taranggana Prabaswara",
    photo: "https://images.unsplash.com/photo-1519085360753-af0119f7cbe7?auto=format&fit=crop&w=400&q=80",
    desc: "Jembatan komunikasi eksternal dengan pihak sekolah, jejaring sispala/mapala, dan alumni.",
    socials: {
      instagram: "https://instagram.com",
      linkedin: "https://linkedin.com",
      whatsapp: "https://wa.me/6281200000005",
    },
  },
];
---

<Layout title="Struktur Badan Pengurus Harian - KPA Trinawa Bhuwana SMAN 39 Jakarta">
  <main class="w-full pt-20 bg-surface flex flex-col min-h-screen">
    
    <!-- SECTION 1: HEADER & STATISTIK PENGURUS -->
    <section class="relative w-full py-12 md:py-16 px-4 md:px-8 lg:px-12 bg-surface overflow-hidden border-b border-outline-variant/30">
      <!-- Glow Accents -->
      <div class="absolute top-0 right-0 w-96 h-96 bg-primary/5 rounded-full blur-3xl pointer-events-none -mr-20 -mt-20"></div>
      <div class="absolute bottom-0 left-0 w-80 h-80 bg-secondary/5 rounded-full blur-2xl pointer-events-none -ml-16 -mb-16"></div>

      <div class="max-w-[1440px] mx-auto relative z-10">
        <!-- Breadcrumb & Tag -->
        <div class="flex items-center gap-2 mb-4">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-primary/10 border border-primary/25 text-primary text-xs font-bold uppercase tracking-wider">
            <span class="material-symbols-outlined text-[16px]">account_tree</span>
            Bagan Organisasi Resmi
          </span>
          <span class="text-on-surface-variant/40 text-xs">/</span>
          <span class="text-xs text-on-surface-variant">Kepengurusan Aktif</span>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-end">
          <div class="lg:col-span-8 flex flex-col gap-3">
            <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-on-surface tracking-tight leading-tight uppercase">
              Badan Pengurus Harian <br class="hidden sm:inline" />
              <span class="text-primary font-bold">Trinawa Bhuwana</span>
            </h1>
            <p class="text-sm sm:text-base text-on-surface-variant max-w-2xl leading-relaxed">
              Bagan hierarki komando dan tata kelola kepengurusan inti KPA SMAN 39 Jakarta periode aktif. Menjalankan mandat organisasi dengan integritas, dedikasi, dan loyalitas rimba.
            </p>

            <!-- Sub Nav Links ke Sejarah & Logo -->
            <div class="flex flex-wrap items-center gap-2.5 mt-2">
              <a
                href={`${base}/struktur`}
                class="px-3.5 py-1.5 rounded-xl text-xs font-bold bg-primary text-white shadow-xs"
              >
                Bagan Struktur
              </a>
              <a
                href={`${base}/struktur/sejarah`}
                class="px-3.5 py-1.5 rounded-xl text-xs font-bold text-on-surface-variant bg-surface-container-low hover:text-primary transition-colors border border-outline-variant/30 flex items-center gap-1.5"
              >
                <span class="material-symbols-outlined text-[15px]">menu_book</span>
                <span>Sejarah Organisasi</span>
              </a>
              <a
                href={`${base}/struktur/logo`}
                class="px-3.5 py-1.5 rounded-xl text-xs font-bold text-on-surface-variant bg-surface-container-low hover:text-primary transition-colors border border-outline-variant/30 flex items-center gap-1.5"
              >
                <span class="material-symbols-outlined text-[15px]">token</span>
                <span>Makna Lambang Logo</span>
              </a>
            </div>
          </div>

          <!-- Quick Stats Pill -->
          <div class="lg:col-span-4 grid grid-cols-3 gap-3">
            <div class="bg-surface-container-low p-4 rounded-2xl border border-outline-variant/20 flex flex-col justify-between shadow-xs">
              <span class="text-[10px] font-bold uppercase text-on-surface-variant tracking-wider">Pucuk Pimpinan</span>
              <div class="text-2xl font-black text-primary mt-1">2</div>
              <span class="text-[11px] text-on-surface-variant">Ketua &amp; Wakil</span>
            </div>
            <div class="bg-surface-container-low p-4 rounded-2xl border border-outline-variant/20 flex flex-col justify-between shadow-xs">
              <span class="text-[10px] font-bold uppercase text-on-surface-variant tracking-wider">Divisi Inti</span>
              <div class="text-2xl font-black text-secondary mt-1">3</div>
              <span class="text-[11px] text-on-surface-variant">Sekretariat/Keu/Humas</span>
            </div>
            <div class="bg-surface-container-low p-4 rounded-2xl border border-outline-variant/20 flex flex-col justify-between shadow-xs">
              <span class="text-[10px] font-bold uppercase text-on-surface-variant tracking-wider">Masa Bakti</span>
              <div class="text-2xl font-black text-emerald-600 mt-1">1 Thn</div>
              <span class="text-[11px] text-on-surface-variant">Periode Aktif</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 2: ORGANIZATIONAL NODE TREE HIERARCHY -->
    <section class="w-full py-16 md:py-24 px-4 md:px-8 lg:px-12 bg-surface-container-lowest overflow-x-auto">
      <div class="max-w-[1280px] mx-auto min-w-[340px] md:min-w-[860px] flex flex-col items-center">
        
        <!-- ================= LEVEL 1: KETUA UMUM ================= -->
        <div class="flex flex-col items-center relative z-20">
          <!-- Card Ketua -->
          <div class="w-full max-w-[380px] bg-white rounded-3xl p-6 shadow-xl border-2 border-primary hover:border-primary transition-all duration-300 hover:shadow-2xl hover:scale-[1.02] group text-slate-800">
            <!-- Top Badges -->
            <div class="flex items-center justify-between gap-2 mb-4">
              <span class={`px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider ${leadership.ketua.roleBadgeClass} shadow-sm flex items-center gap-1.5`}>
                <span class="material-symbols-outlined text-[15px]">military_tech</span>
                {leadership.ketua.role}
              </span>
              <span class="px-2.5 py-0.5 rounded-lg bg-slate-100 text-slate-600 font-mono font-bold text-xs">
                {leadership.ketua.roleCode}
              </span>
            </div>

            <!-- Profile Info Lockup -->
            <div class="flex items-center gap-4">
              <!-- Avatar with Ring -->
              <div class="relative shrink-0">
                <img
                  src={leadership.ketua.photo}
                  alt={leadership.ketua.name}
                  class="w-20 h-20 rounded-2xl object-cover object-center ring-4 ring-primary/20 shadow-md group-hover:ring-primary transition-all duration-300"
                />
                <span class="absolute -bottom-1 -right-1 w-6 h-6 rounded-full bg-primary text-white flex items-center justify-center text-[13px] font-bold shadow-xs">
                  ★
                </span>
              </div>

              <!-- Name & Credentials -->
              <div class="flex flex-col flex-1">
                <h3 class="text-base font-extrabold uppercase text-slate-900 group-hover:text-primary transition-colors leading-snug">
                  {leadership.ketua.name}
                </h3>
                <span class="text-xs font-bold text-[#FF8000] mt-0.5">
                  "{leadership.ketua.rimbaName}"
                </span>
                <!-- NIK Code -->
                <div class="mt-2 flex items-center gap-1 text-[11px] font-mono text-slate-500 bg-slate-50 px-2 py-0.5 rounded border border-slate-100 w-fit">
                  <span class="material-symbols-outlined text-[13px] text-slate-400">badge</span>
                  <span>NIK: {leadership.ketua.nik}</span>
                </div>
              </div>
            </div>

            <!-- Quote / Brief -->
            <p class="text-xs text-slate-500 mt-4 pt-3 border-t border-slate-100 leading-relaxed italic">
              "{leadership.ketua.quote}"
            </p>

            <!-- Social Links -->
            <div class="flex items-center justify-between pt-3 mt-1 border-t border-slate-100/60">
              <span class="text-[11px] font-bold text-slate-400">{leadership.ketua.angkatan}</span>
              <div class="flex items-center gap-1.5">
                <a
                  href={leadership.ketua.socials.instagram}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="w-7 h-7 rounded-lg bg-slate-100 hover:bg-[#FF8000] hover:text-white text-slate-600 flex items-center justify-center transition-colors"
                  title="Instagram"
                >
                  <span class="material-symbols-outlined text-[16px]">photo_camera</span>
                </a>
                <a
                  href={leadership.ketua.socials.linkedin}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="w-7 h-7 rounded-lg bg-slate-100 hover:bg-[#065143] hover:text-white text-slate-600 flex items-center justify-center transition-colors"
                  title="LinkedIn"
                >
                  <span class="material-symbols-outlined text-[16px]">work</span>
                </a>
                <a
                  href={leadership.ketua.socials.whatsapp}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="w-7 h-7 rounded-lg bg-slate-100 hover:bg-emerald-600 hover:text-white text-slate-600 flex items-center justify-center transition-colors"
                  title="WhatsApp"
                >
                  <span class="material-symbols-outlined text-[16px]">chat</span>
                </a>
              </div>
            </div>
          </div>

          <!-- Vertical Spine Connector (Line 1 to 2) -->
          <div class="w-1 h-12 bg-gradient-to-b from-primary to-secondary relative">
            <!-- Pulse Node Dot -->
            <div class="w-3 h-3 rounded-full bg-primary absolute -top-1 left-1/2 -translate-x-1/2 ring-4 ring-white shadow-xs"></div>
          </div>
        </div>

        <!-- ================= LEVEL 2: WAKIL KETUA UMUM ================= -->
        <div class="flex flex-col items-center relative z-20">
          <!-- Card Wakil Ketua -->
          <div class="w-full max-w-[380px] bg-white rounded-3xl p-6 shadow-xl border-2 border-secondary hover:border-secondary transition-all duration-300 hover:shadow-2xl hover:scale-[1.02] group text-slate-800">
            <!-- Top Badges -->
            <div class="flex items-center justify-between gap-2 mb-4">
              <span class={`px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider ${leadership.wakil.roleBadgeClass} shadow-sm flex items-center gap-1.5`}>
                <span class="material-symbols-outlined text-[15px]">shield</span>
                {leadership.wakil.role}
              </span>
              <span class="px-2.5 py-0.5 rounded-lg bg-slate-100 text-slate-600 font-mono font-bold text-xs">
                {leadership.wakil.roleCode}
              </span>
            </div>

            <!-- Profile Info Lockup -->
            <div class="flex items-center gap-4">
              <!-- Avatar with Ring -->
              <div class="relative shrink-0">
                <img
                  src={leadership.wakil.photo}
                  alt={leadership.wakil.name}
                  class="w-20 h-20 rounded-2xl object-cover object-center ring-4 ring-secondary/20 shadow-md group-hover:ring-secondary transition-all duration-300"
                />
                <span class="absolute -bottom-1 -right-1 w-6 h-6 rounded-full bg-secondary text-white flex items-center justify-center text-[12px] font-bold shadow-xs">
                  2
                </span>
              </div>

              <!-- Name & Credentials -->
              <div class="flex flex-col flex-1">
                <h3 class="text-base font-extrabold uppercase text-slate-900 group-hover:text-secondary transition-colors leading-snug">
                  {leadership.wakil.name}
                </h3>
                <span class="text-xs font-bold text-secondary mt-0.5">
                  "{leadership.wakil.rimbaName}"
                </span>
                <!-- NIK Code -->
                <div class="mt-2 flex items-center gap-1 text-[11px] font-mono text-slate-500 bg-slate-50 px-2 py-0.5 rounded border border-slate-100 w-fit">
                  <span class="material-symbols-outlined text-[13px] text-slate-400">badge</span>
                  <span>NIK: {leadership.wakil.nik}</span>
                </div>
              </div>
            </div>

            <!-- Quote / Brief -->
            <p class="text-xs text-slate-500 mt-4 pt-3 border-t border-slate-100 leading-relaxed italic">
              "{leadership.wakil.quote}"
            </p>

            <!-- Social Links -->
            <div class="flex items-center justify-between pt-3 mt-1 border-t border-slate-100/60">
              <span class="text-[11px] font-bold text-slate-400">{leadership.wakil.angkatan}</span>
              <div class="flex items-center gap-1.5">
                <a
                  href={leadership.wakil.socials.instagram}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="w-7 h-7 rounded-lg bg-slate-100 hover:bg-[#FF8000] hover:text-white text-slate-600 flex items-center justify-center transition-colors"
                  title="Instagram"
                >
                  <span class="material-symbols-outlined text-[16px]">photo_camera</span>
                </a>
                <a
                  href={leadership.wakil.socials.linkedin}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="w-7 h-7 rounded-lg bg-slate-100 hover:bg-[#065143] hover:text-white text-slate-600 flex items-center justify-center transition-colors"
                  title="LinkedIn"
                >
                  <span class="material-symbols-outlined text-[16px]">work</span>
                </a>
                <a
                  href={leadership.wakil.socials.whatsapp}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="w-7 h-7 rounded-lg bg-slate-100 hover:bg-emerald-600 hover:text-white text-slate-600 flex items-center justify-center transition-colors"
                  title="WhatsApp"
                >
                  <span class="material-symbols-outlined text-[16px]">chat</span>
                </a>
              </div>
            </div>
          </div>

          <!-- Vertical Spine Connector (Line 2 to Branching Bus) -->
          <div class="w-1 h-12 bg-secondary relative">
            <div class="w-3 h-3 rounded-full bg-secondary absolute -top-1 left-1/2 -translate-x-1/2 ring-4 ring-white shadow-xs"></div>
          </div>
        </div>

        <!-- ================= BRANCHING BUS CONNECTOR TO LEVEL 3 ================= -->
        <!-- Responsive T-Tree Bar on Desktop/Tablet -->
        <div class="hidden md:flex flex-col items-center w-full max-w-[1080px] relative z-10 -mt-0.5">
          <!-- Horizontal Branch Bar across 3 columns -->
          <div class="w-2/3 h-1 bg-gradient-to-r from-[#065143] via-secondary to-teal-700 rounded-full relative">
            <!-- Center Junction Node -->
            <div class="w-4 h-4 rounded-full bg-secondary absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 ring-4 ring-white shadow-sm"></div>
            <!-- Left Junction Node -->
            <div class="w-3.5 h-3.5 rounded-full bg-[#065143] absolute top-1/2 left-0 -translate-x-1/2 -translate-y-1/2 ring-4 ring-white shadow-xs"></div>
            <!-- Right Junction Node -->
            <div class="w-3.5 h-3.5 rounded-full bg-teal-700 absolute top-1/2 right-0 translate-x-1/2 -translate-y-1/2 ring-4 ring-white shadow-xs"></div>
          </div>

          <!-- 3 Drop Down Vertical Connectors -->
          <div class="w-2/3 grid grid-cols-3">
            <div class="flex justify-start">
              <div class="w-1 h-8 bg-[#065143]"></div>
            </div>
            <div class="flex justify-center">
              <div class="w-1 h-8 bg-[#FF8000]"></div>
            </div>
            <div class="flex justify-end">
              <div class="w-1 h-8 bg-teal-700"></div>
            </div>
          </div>
        </div>

        <!-- Mobile Connector Spine -->
        <div class="flex md:hidden w-1 h-8 bg-secondary -mt-0.5"></div>

        <!-- ================= LEVEL 3: BENDAHARA, SEKRETARIS, HUMAS ================= -->
        <div class="w-full max-w-[1240px] grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8 pt-2 relative z-20">
          {staffMembers.map((member, idx) => (
            <div class="flex flex-col bg-white rounded-3xl p-6 shadow-xl border border-slate-200/80 hover:border-slate-400/60 hover:shadow-2xl hover:scale-[1.02] transition-all duration-300 group text-slate-800">
              
              <!-- Role Badge & Code -->
              <div class="flex items-center justify-between gap-2 mb-4">
                <span class={`px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider ${member.roleBadgeClass} shadow-sm`}>
                  {member.role}
                </span>
                <span class="px-2.5 py-0.5 rounded-lg bg-slate-100 text-slate-600 font-mono font-bold text-xs">
                  {member.roleCode}
                </span>
              </div>

              <!-- Profile Info -->
              <div class="flex items-center gap-3.5">
                <!-- Avatar -->
                <div class="relative shrink-0">
                  <img
                    src={member.photo}
                    alt={member.name}
                    class="w-16 h-16 rounded-2xl object-cover object-center ring-4 ring-slate-100 group-hover:ring-[#065143]/30 transition-all duration-300 shadow-md"
                  />
                </div>

                <div class="flex flex-col flex-1">
                  <h4 class="text-sm font-extrabold uppercase text-slate-900 group-hover:text-[#065143] transition-colors leading-snug">
                    {member.name}
                  </h4>
                  <span class="text-xs font-bold text-[#FF8000] mt-0.5">
                    "{member.rimbaName}"
                  </span>
                  <!-- NIK Code -->
                  <div class="mt-1.5 flex items-center gap-1 text-[10px] font-mono text-slate-500 bg-slate-50 px-2 py-0.5 rounded border border-slate-100 w-fit">
                    <span class="material-symbols-outlined text-[12px] text-slate-400">badge</span>
                    <span>NIK: {member.nik}</span>
                  </div>
                </div>
              </div>

              <!-- Description -->
              <p class="text-xs text-slate-500 mt-4 pt-3 border-t border-slate-100 leading-relaxed flex-1">
                {member.desc}
              </p>

              <!-- Footer with Angkatan & Socials -->
              <div class="flex items-center justify-between pt-3 mt-2 border-t border-slate-100/60">
                <span class="text-[10px] font-bold text-slate-400">{member.angkatan}</span>
                <div class="flex items-center gap-1.5">
                  <a
                    href={member.socials.instagram}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="w-7 h-7 rounded-lg bg-slate-100 hover:bg-[#FF8000] hover:text-white text-slate-600 flex items-center justify-center transition-colors"
                    title="Instagram"
                  >
                    <span class="material-symbols-outlined text-[15px]">photo_camera</span>
                  </a>
                  <a
                    href={member.socials.linkedin}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="w-7 h-7 rounded-lg bg-slate-100 hover:bg-[#065143] hover:text-white text-slate-600 flex items-center justify-center transition-colors"
                    title="LinkedIn"
                  >
                    <span class="material-symbols-outlined text-[15px]">work</span>
                  </a>
                  <a
                    href={member.socials.whatsapp}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="w-7 h-7 rounded-lg bg-slate-100 hover:bg-emerald-600 hover:text-white text-slate-600 flex items-center justify-center transition-colors"
                    title="WhatsApp"
                  >
                    <span class="material-symbols-outlined text-[15px]">chat</span>
                  </a>
                </div>
              </div>

            </div>
          ))}
        </div>

      </div>
    </section>

    <!-- SECTION: LANDASAN KONSTITUSI & ATURAN STRUKTURAL -->
    <section class="w-full py-16 px-4 md:px-8 lg:px-12 bg-slate-50 border-t border-slate-200">
      <div class="max-w-[1280px] mx-auto flex flex-col items-center">
        
        <div class="text-center max-w-2xl mb-12">
          <span class="text-xs font-black uppercase tracking-widest text-[#FF8000] bg-[#FF8000]/10 px-3 py-1 rounded-full">
            Landasan Hukum &amp; Aturan
          </span>
          <h3 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight uppercase mt-3">
            Konstitusi &amp; Tata Kelola Organisasi
          </h3>
          <p class="text-xs sm:text-sm text-slate-600 mt-2 leading-relaxed">
            Pedoman dasar perumusan mandat, tata kelola keorganisasian, serta etika kedisiplinan anggota KPA Trinawa Bhuwana SMAN 39 Jakarta.
          </p>
        </div>

