      <!-- CLIENT-SIDE SCRIPT FOR FILTERING & SEARCH -->
      <script>
        document.addEventListener("DOMContentLoaded", () => {
          const eraButtons = document.querySelectorAll(".era-btn");
          const searchInput = document.getElementById("search-angkatan");
          const clearBtn = document.getElementById("clear-search");
          const timelineItems = document.querySelectorAll(".timeline-item");
          const noResults = document.getElementById("no-results");
          const counterText = document.getElementById("filtered-count");

          let currentEra = "all";
          let currentQuery = "";

          function filterTimeline() {
            let visibleCount = 0;

            timelineItems.forEach((item) => {
              const itemEra = item.getAttribute("data-era");
              const name = item.getAttribute("data-name") || "";
              const code = item.getAttribute("data-code") || "";
              const year = item.getAttribute("data-year") || "";
              const loc = item.getAttribute("data-location") || "";
              const num = item.getAttribute("data-angkatan") || "";

              const eraMatch = currentEra === "all" || currentEra === itemEra;
              const query = currentQuery.toLowerCase().trim();

              const textMatch =
                !query ||
                name.includes(query) ||
                code.includes(query) ||
                year.includes(query) ||
                loc.includes(query) ||
                num === query;

              if (eraMatch && textMatch) {
                item.style.display = "flex";
                visibleCount++;
              } else {
                item.style.display = "none";
              }
            });

            // Toggle Empty State
            if (visibleCount === 0) {
              noResults.classList.remove("hidden");
            } else {
              noResults.classList.add("hidden");
            }

            // Update counter label
            if (counterText) {
              counterText.textContent = `Menampilkan ${visibleCount} dari ${timelineItems.length} Angkatan`;
            }
          }

          // Era Tabs event
          eraButtons.forEach((btn) => {
            btn.addEventListener("click", () => {
              eraButtons.forEach((b) => {
                b.classList.remove(
                  "bg-primary",
                  "text-on-primary",
                  "shadow-sm",
                );
                b.classList.add("text-on-surface-variant");
              });
              btn.classList.add("bg-primary", "text-on-primary", "shadow-sm");
              btn.classList.remove("text-on-surface-variant");

              currentEra = btn.getAttribute("data-era") || "all";
              filterTimeline();
            });
          });

          // Search input event
          searchInput.addEventListener("input", (e) => {
            currentQuery = e.target.value;
            if (currentQuery.length > 0) {
              clearBtn.classList.remove("hidden");
            } else {
              clearBtn.classList.add("hidden");
            }
            filterTimeline();
          });

          // Clear search button
          clearBtn.addEventListener("click", () => {
            searchInput.value = "";
            currentQuery = "";
            clearBtn.classList.add("hidden");
            filterTimeline();
            searchInput.focus();
          });

          // ALUMNI FORM GOOGLE SHEET INTEGRATION
          const alumniForm = document.getElementById("alumni-form");
          const submitBtn = document.getElementById("submit-btn");
          const btnText = document.getElementById("btn-text");
          const btnIcon = document.getElementById("btn-icon");
          const formAlert = document.getElementById("form-alert");

          // Duplicate Modal elements
          const duplicateModal = document.getElementById("duplicate-modal");
          const modalBackdrop = document.getElementById("modal-backdrop");
          const modalContent = document.getElementById("modal-content");
          const closeModalBtn = document.getElementById("close-modal-btn");
          const duplicateTypeLabel = document.getElementById(
            "duplicate-type-label",
          );
          const duplicateDesc = document.getElementById("duplicate-desc");

          function showDuplicateModal(type, value) {
            if (!duplicateModal) return;

            let labelText = "Nomor WhatsApp atau Email Telah Ada";
            let descText =
              "Data yang Anda masukkan sudah pernah terdaftar di lembar sensus alumni.";

            if (type === "phone") {
              labelText = "Nomor WhatsApp Sudah Terdaftar!";
              descText = `Nomor WhatsApp (${value}) sudah pernah digunakan untuk pengisian sensus alumni KPA Trinawa Bhuwana SMAN 39.`;
            } else if (type === "email") {
              labelText = "Alamat Email Sudah Terdaftar!";
              descText = `Alamat Email (${value}) sudah pernah digunakan untuk pengisian sensus alumni KPA Trinawa Bhuwana SMAN 39.`;
            } else if (type === "both") {
              labelText = "WhatsApp & Email Sudah Terdaftar!";
              descText = `Nomor WhatsApp dan Alamat Email yang Anda masukkan sudah tercatat di basis data alumni KPA Trinawa Bhuwana SMAN 39.`;
            }

            if (duplicateTypeLabel) duplicateTypeLabel.textContent = labelText;
            if (duplicateDesc) duplicateDesc.textContent = descText;

            // Show modal with animation
            duplicateModal.classList.remove("hidden");
            setTimeout(() => {
              if (modalContent) {
                modalContent.classList.remove(
                  "translate-y-full",
                  "md:scale-95",
                );
                modalContent.classList.add("translate-y-0", "md:scale-100");
              }
            }, 10);
          }

          function hideDuplicateModal() {
            if (!duplicateModal) return;
            if (modalContent) {
              modalContent.classList.remove("translate-y-0", "md:scale-100");
              modalContent.classList.add("translate-y-full", "md:scale-95");
            }
            setTimeout(() => {
              duplicateModal.classList.add("hidden");
            }, 250);
          }

          if (closeModalBtn)
            closeModalBtn.addEventListener("click", hideDuplicateModal);
          if (modalBackdrop)
            modalBackdrop.addEventListener("click", hideDuplicateModal);

          // Handle Photo Input: Preview & Validation (Dimensi 1:1, Max 150KB)
          const photoInput = document.getElementById("alumni-photo");
          const photoPreviewImg = document.getElementById("photo-preview-img");
          const photoPlaceholderIcon = document.getElementById(
            "photo-placeholder-icon",
          );
          const photoNameDisplay =
            document.getElementById("photo-name-display");
          const photoHintDisplay =
            document.getElementById("photo-hint-display");

          let selectedPhotoFile = null;

          if (photoInput) {
            photoInput.addEventListener("change", () => {
              if (photoInput.files && photoInput.files[0]) {
                const file = photoInput.files[0];

                // 1. Validasi Ukuran (Maks 150KB)
                if (file.size > 150 * 1024) {
                  alert(
                    `Ukuran foto (${(file.size / 1024).toFixed(1)} KB) melebihi batas maksimal 150 KB. Silakan kompres atau pilih foto yang lebih kecil.`,
                  );
                  photoInput.value = "";
                  selectedPhotoFile = null;
                  if (photoPreviewImg) photoPreviewImg.classList.add("hidden");
                  if (photoPlaceholderIcon)
                    photoPlaceholderIcon.classList.remove("hidden");
                  if (photoNameDisplay)
                    photoNameDisplay.textContent =
                      "Pilih atau Seret Foto Profil Anda (JPG / PNG)";
                  return;
                }

                // 2. Validasi Dimensi 1:1 (Rasio Persegi)
                const img = new Image();
                img.onload = () => {
                  const width = img.naturalWidth;
                  const height = img.naturalHeight;
                  const ratio = width / height;

                  // Toleransi rasio 1:1 sedikit (0.95 - 1.05)
                  if (ratio < 0.9 || ratio > 1.1) {
                    alert(
                      `Foto tidak berdimensi persegi / rasio 1:1 (Terdeteksi ${width} x ${height} px). Mohon gunakan foto dengan dimensi 1024 x 1024 atau rasio 1:1.`,
                    );
                    photoInput.value = "";
                    selectedPhotoFile = null;
                    if (photoPreviewImg)
                      photoPreviewImg.classList.add("hidden");
                    if (photoPlaceholderIcon)
                      photoPlaceholderIcon.classList.remove("hidden");
                    if (photoNameDisplay)
                      photoNameDisplay.textContent =
                        "Pilih atau Seret Foto Profil Anda (JPG / PNG)";
                    return;
                  }

                  selectedPhotoFile = file;
                  if (photoPreviewImg) {
                    photoPreviewImg.src = img.src;
                    photoPreviewImg.classList.remove("hidden");
                  }
                  if (photoPlaceholderIcon)
                    photoPlaceholderIcon.classList.add("hidden");
                  if (photoNameDisplay) {
                    photoNameDisplay.textContent = `${file.name} (${width}x${height}px, ${(file.size / 1024).toFixed(1)} KB)`;
                    photoNameDisplay.classList.add("text-[#065143]");
                  }
                  if (photoHintDisplay) {
                    photoHintDisplay.textContent =
                      "Foto memenuhi syarat (rasio 1:1, di bawah 150KB) & siap diunggah.";
                  }
                };

                img.onerror = () => {
                  alert("File bukan gambar yang valid.");
                  photoInput.value = "";
                };

                const reader = new FileReader();
                reader.onload = (e) => {
                  img.src = e.target?.result;
                };
                reader.readAsDataURL(file);
              }
            });
          }

          const SCRIPT_URL =
            "https://script.google.com/macros/s/AKfycbz6STe8qXFifMIflfgxtjGPKU5GZBMAp8PHKqjRtgh5KVNAMhglQSosFkPK_rfIwbwB/exec";

          if (alumniForm) {
            alumniForm.addEventListener("submit", async (e) => {
              e.preventDefault();

              // Validation check: Name (string only, no digits)
              const nameInput = document.getElementById("full-name");
              const nameVal = nameInput ? nameInput.value.trim() : "";
              const namePattern = /^[a-zA-Z\s.,'-]+$/;
              if (!namePattern.test(nameVal)) {
                formAlert.className =
                  "md:col-span-2 p-4 rounded-xl text-sm font-semibold bg-red-600 border border-red-700 text-white shadow-md flex items-center gap-2.5";
                formAlert.innerHTML =
                  '<span class="material-symbols-outlined text-white text-[22px]">warning</span> <span>Nama Lengkap hanya boleh berisi huruf dan gelar (tidak boleh ada angka).</span>';
                formAlert.classList.remove("hidden");
                nameInput.focus();
                return;
              }

              // Validation check: Phone (valid phone numbers only)
              const phoneInput = document.getElementById("phone-number");
              const phoneVal = phoneInput ? phoneInput.value.trim() : "";
              const phonePattern = /^(\+62|62|0)[0-9]{8,14}$/;
              if (!phonePattern.test(phoneVal)) {
                formAlert.className =
                  "md:col-span-2 p-4 rounded-xl text-sm font-semibold bg-red-600 border border-red-700 text-white shadow-md flex items-center gap-2.5";
                formAlert.innerHTML =
                  '<span class="material-symbols-outlined text-white text-[22px]">warning</span> <span>Nomor WhatsApp hanya boleh berupa angka yang valid (contoh: 081288889999).</span>';
                formAlert.classList.remove("hidden");
                phoneInput.focus();
                return;
              }

              // Validation check: Email
              const emailInput = document.getElementById("email");
              const emailVal = emailInput ? emailInput.value.trim() : "";
              const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
              if (!emailPattern.test(emailVal)) {
                formAlert.className =
                  "md:col-span-2 p-4 rounded-xl text-sm font-semibold bg-red-600 border border-red-700 text-white shadow-md flex items-center gap-2.5";
                formAlert.innerHTML =
                  '<span class="material-symbols-outlined text-white text-[22px]">warning</span> <span>Mohon masukkan alamat email yang valid.</span>';
                formAlert.classList.remove("hidden");
                emailInput.focus();
                return;
              }

              // Set loading state
              submitBtn.disabled = true;
              btnText.textContent = "Memverifikasi Data...";
              btnIcon.textContent = "hourglass_top";
              formAlert.classList.add("hidden");

              const formData = {
                fullName: nameVal,
                rimbaName: document.getElementById("rimba-name")?.value || "",
                angkatan:
                  document.getElementById("angkatan-select")?.value || "",
                gradYear: document.getElementById("grad-year")?.value || "",
                phone: phoneVal,
                email: emailVal,
                domicile: document.getElementById("domicile")?.value || "",
                message: document.getElementById("alumni-message")?.value || "",
                timestamp: new Date().toISOString(),
              };

              try {
                // STEP 1: Check duplicate phone & email via GET to Google Apps Script
                const checkUrl = `${SCRIPT_URL}?check=duplicate&phone=${encodeURIComponent(phoneVal)}&email=${encodeURIComponent(emailVal)}`;
                const checkRes = await fetch(checkUrl);
                const checkData = await checkRes.json();

                if (checkData && checkData.isDuplicate) {
                  // Show responsive Modal (Popup on desktop, Drawer on mobile)
                  showDuplicateModal(
                    checkData.duplicateField,
                    checkData.duplicateField === "phone" ? phoneVal : emailVal,
                  );
                  return;
                }

                // STEP 2: Proceed to save data if not duplicate
                // Handle Photo Base64 if selected
                let photoBase64 = "";
                let photoOriginalName = "";
                let photoMimeType = "";

                if (selectedPhotoFile) {
                  btnText.textContent = "Mengunggah Foto Profil...";
                  const base64Promise = new Promise((resolve, reject) => {
                    const reader = new FileReader();
                    reader.onload = () => {
                      const res = reader.result;
                      if (typeof res === "string") {
                        resolve(res.split(",")[1]);
                      } else {
                        resolve("");
                      }
                    };
                    reader.onerror = reject;
                    reader.readAsDataURL(selectedPhotoFile);
                  });
                  photoBase64 = await base64Promise;
                  photoOriginalName = selectedPhotoFile.name;
                  photoMimeType = selectedPhotoFile.type;
                }

                formData.photoBase64 = photoBase64;
                formData.photoOriginalName = photoOriginalName;
                formData.photoMimeType = photoMimeType;
                formData.status = "Pending";

                btnText.textContent = "Menyimpan ke Sheet...";
                await fetch(SCRIPT_URL, {
                  method: "POST",
                  mode: "no-cors",
                  headers: {
                    "Content-Type": "text/plain;charset=utf-8",
                  },
                  body: JSON.stringify(formData),
                });

                // Display success message
                formAlert.className =
                  "md:col-span-2 p-4 rounded-xl text-sm font-semibold bg-[#065143] border border-[#065143]/80 text-white shadow-md flex items-center gap-2.5";
                formAlert.innerHTML =
                  '<span class="material-symbols-outlined text-[#FF8000] text-[22px]">check_circle</span> <span>Terima kasih! Data sensus alumni dan foto profil berhasil disimpan ke Google Sheet & Drive dengan status Pending.</span>';
                formAlert.classList.remove("hidden");

                alumniForm.reset();
                selectedPhotoFile = null;
                if (photoPreviewImg) photoPreviewImg.classList.add("hidden");
                if (photoPlaceholderIcon)
                  photoPlaceholderIcon.classList.remove("hidden");
                if (photoNameDisplay) {
                  photoNameDisplay.textContent =
                    "Pilih atau Seret Foto Profil Anda (JPG / PNG)";
                  photoNameDisplay.classList.remove("text-[#065143]");
                }
              } catch (error) {
                console.error("Error submitting form:", error);
                formAlert.className =
                  "md:col-span-2 p-4 rounded-xl text-sm font-semibold bg-red-600 border border-red-700 text-white shadow-md flex items-center gap-2.5";
                formAlert.innerHTML =
                  '<span class="material-symbols-outlined text-white text-[22px]">error</span> <span>Terjadi kesalahan saat memverifikasi atau mengirim data. Silakan coba lagi.</span>';
                formAlert.classList.remove("hidden");
              } finally {
                // Restore button state
                submitBtn.disabled = false;
                btnText.textContent = "Kirim Formulir Pendataan";
                btnIcon.textContent = "send";
              }
            });
          }
        });
      </script>
    </div>
  </main>
</Layout>
