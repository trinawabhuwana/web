---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Silsilah Angkatan - KPA Trinawa Bhuwana SMAN 39 Jakarta">
  <main class="w-full pt-20 bg-surface">
    <div class="flex flex-col w-full">
      <!-- SECTION 1: HEADER & STATISTIK RINGKAS -->
      <section class="relative w-full py-16 px-4 md:px-8 lg:px-12 bg-surface overflow-hidden">
        <!-- Topographic Accent Line & Glows -->
        <div class="absolute top-0 right-0 w-96 h-96 bg-primary/5 rounded-full blur-3xl pointer-events-none -mr-20 -mt-20"></div>
        <div class="absolute bottom-0 left-0 w-80 h-80 bg-secondary/5 rounded-full blur-2xl pointer-events-none -ml-16 -mb-16"></div>
        <div class="max-w-[1440px] mx-auto relative z-10">
          <!-- Breadcrumb & Tag -->
          <div class="flex items-center gap-2 mb-4">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-primary-fixed text-on-primary-fixed text-xs font-semibold uppercase tracking-wider">
              <span class="material-symbols-outlined text-[15px]">
                history_edu
              </span>
              Arsip Resmi
            </span>
            <span class="text-on-surface-variant/60 text-xs">
              / Silsilah &amp; Tradisi
            </span>
          </div>
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-end">
            <div class="lg:col-span-8 flex flex-col gap-3">
              <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-on-surface tracking-tight leading-tight">
                Silsilah Angkatan <br class="hidden sm:inline" />
                <span class="text-primary">Trinawa Bhuwana</span>
              </h1>
              <p class="text-base sm:text-lg text-on-surface-variant max-w-3xl leading-relaxed">
                Menelusuri jejak langkah, nama kehormatan, dan riwayat lokasi
                Pendidikan Dasar dari Angkatan 1 (1985) hingga Angkatan 42
                (2026). Pilar tegak persaudaraan rimba SMAN 39 Jakarta.
              </p>
            </div>
            <!-- Metric Stat Cards -->
            <div class="lg:col-span-4 grid grid-cols-3 gap-3">
              <div class="bg-surface-container-low rounded-xl p-4 shadow-sm flex flex-col justify-between">
                <span class="text-xs uppercase font-bold text-on-surface-variant tracking-wider">
                  Generasi
                </span>
                <div class="text-2xl sm:text-3xl font-black text-primary mt-2">
                  42
                </div>
                <span class="text-[11px] text-on-surface-variant">
                  Terdata resmi
                </span>
              </div>
              <div class="bg-surface-container-low rounded-xl p-4 shadow-sm flex flex-col justify-between">
                <span class="text-xs uppercase font-bold text-on-surface-variant tracking-wider">
                  Dedikasi
                </span>
                <div class="text-2xl sm:text-3xl font-black text-secondary mt-2">
                  41+
                </div>
                <span class="text-[11px] text-on-surface-variant">
                  Tahun sejarah
                </span>
              </div>
              <div class="bg-surface-container-low rounded-xl p-4 shadow-sm flex flex-col justify-between">
                <span class="text-xs uppercase font-bold text-on-surface-variant tracking-wider">
                  Semangat
                </span>
                <div class="text-2xl sm:text-3xl font-black text-tertiary mt-2">
                  100%
                </div>
                <span class="text-[11px] text-on-surface-variant">
                  Jiwa rimba
                </span>
              </div>
            </div>
          </div>
        </div>
      </section>
      <!-- SECTION 2: INTERACTIVE FILTER CONTROLS & SEARCH -->
      <section class="sticky top-20 z-40 w-full py-4 px-4 md:px-8 lg:px-12 bg-surface/90 backdrop-blur-md shadow-sm">
        <div class="max-w-[1440px] mx-auto flex flex-col md:flex-row items-center justify-between gap-4">
          <!-- Era Filter Tabs -->
          <div
            class="flex items-center gap-1.5 p-1 bg-surface-container rounded-xl overflow-x-auto w-full md:w-auto scrollbar-none"
            id="era-tabs"
          >
            <button
              class="era-btn px-4 py-2 text-xs font-semibold rounded-lg bg-primary text-on-primary shadow-sm whitespace-nowrap transition-all"
              data-era="all"
              type="button"
            >
              Semua (1–42)
            </button>
            <button
              class="era-btn px-4 py-2 text-xs font-semibold rounded-lg text-on-surface-variant hover:text-on-surface whitespace-nowrap transition-all"
              data-era="perintis"
              type="button"
            >
              Era Perintis (1985–1994)
            </button>
            <button
              class="era-btn px-4 py-2 text-xs font-semibold rounded-lg text-on-surface-variant hover:text-on-surface whitespace-nowrap transition-all"
              data-era="penjelajah"
              type="button"
            >
              Era Penjelajah (1995–2004)
            </button>
            <button
              class="era-btn px-4 py-2 text-xs font-semibold rounded-lg text-on-surface-variant hover:text-on-surface whitespace-nowrap transition-all"
              data-era="konservasi"
              type="button"
            >
              Era Konservasi &amp; Modern (2005–2026)
            </button>
          </div>
          <!-- Search Input Field -->
          <div class="relative w-full md:w-80">
            <span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-on-surface-variant text-[20px] pointer-events-none">
              search
            </span>
            <input
              class="w-full h-11 pl-10 pr-4 bg-surface-container-lowest text-on-surface text-sm rounded-xl placeholder:text-on-surface-variant/60 shadow-sm focus:outline-none focus:ring-2 focus:ring-primary transition-all"
              id="search-angkatan"
              placeholder="Cari nama, kode (KP), tahun, lokasi..."
              type="text"
            />
            <button
              class="hidden absolute right-3 top-1/2 -translate-y-1/2 text-on-surface-variant hover:text-on-surface"
              id="clear-search"
            >
              <span class="material-symbols-outlined text-[18px]">close</span>
            </button>
          </div>
        </div>
      </section>
      <!-- SECTION 3: VERTICAL TIMELINE OF 33 GENERATIONS -->
      <section class="w-full py-12 px-4 md:px-8 lg:px-12 bg-surface">
        <div class="max-w-[1440px] mx-auto">
          <!-- Active Results Counter Bar -->
          <div class="flex items-center justify-between mb-8 px-2">
            <div class="flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-secondary"></span>
              <span
                class="text-xs font-semibold uppercase tracking-wider text-on-surface-variant"
                id="filtered-count"
              >
                Menampilkan 42 Angkatan
              </span>
            </div>
            <div class="text-xs text-on-surface-variant hidden sm:flex items-center gap-3">
              <span class="inline-flex items-center gap-1">
                <span class="w-2 h-2 rounded-full bg-primary"></span> Diksar
                Terverifikasi
              </span>
              <span class="inline-flex items-center gap-1">
                <span class="w-2 h-2 rounded-full bg-secondary"></span>{" "}
                Terdaftar di KPA SMAN 39
              </span>
            </div>
          </div>
          <!-- Vertical Timeline Wrapper -->
          <div class="relative">
            <!-- Central Spine Line -->
            <div class="absolute left-6 md:left-1/2 top-4 bottom-4 w-0.5 bg-surface-container-highest -translate-x-1/2"></div>
            <div class="space-y-6" id="timeline-list">
              <!-- Item 1 -->
              <div
                class="timeline-item relative flex flex-col md:flex-row items-start group"
                data-angkatan="1"
                data-code="kp"
                data-era="perintis"
                data-location="klapanunggal cibubur"
                data-name="kabut perintis"
                data-year="1985"
              >
                <div class="hidden md:flex w-1/2 pr-8 text-right flex-col items-end">
                  <span class="text-xs font-bold text-primary tracking-widest uppercase">
                    Era Perintis
                  </span>
                  <span class="text-xl font-black text-on-surface">
                    Tahun 1985
                  </span>
                  <span class="text-xs text-on-surface-variant mt-1 flex items-center gap-1">
                    <span class="material-symbols-outlined text-[14px]">
                      pin_drop
                    </span>
                    Klapanunggal &amp; Cibubur
                  </span>
                </div>
                <!-- Node Marker -->
                <div class="absolute left-6 md:left-1/2 -translate-x-1/2 z-20 w-8 h-8 rounded-full bg-primary text-on-primary flex items-center justify-center font-bold text-xs shadow-md transition-transform group-hover:scale-110">
                  01
                </div>
                <!-- Card Body -->
                <div class="w-full md:w-1/2 pl-14 md:pl-8">
                  <div class="bg-surface-container-lowest p-5 rounded-2xl shadow-sm hover:shadow-md transition-all">
                    <div class="flex items-center justify-between gap-2 mb-2">
                      <span class="px-2.5 py-0.5 rounded-full bg-primary-fixed text-on-primary-fixed text-[11px] font-bold tracking-wider uppercase">
                        Angkatan 1
                      </span>
                      <span class="px-2.5 py-0.5 rounded-lg bg-surface-container text-on-surface font-mono font-bold text-xs">
                        KP
                      </span>
                    </div>
                    <h3 class="text-lg font-bold text-on-surface group-hover:text-primary transition-colors">
                      Kabut Perintis
                    </h3>
                    <div class="mt-3 pt-3 flex flex-wrap items-center gap-y-2 gap-x-4 text-xs text-on-surface-variant">
                      <span class="flex items-center gap-1 font-medium text-on-surface">
                        <span class="material-symbols-outlined text-[15px] text-primary">
                          calendar_today
                        </span>{" "}
                        1985
                      </span>
                      <span class="flex items-center gap-1">
                        <span class="material-symbols-outlined text-[15px] text-secondary">
                          explore
                        </span>{" "}
                        Klapanunggal &amp; Cibubur
