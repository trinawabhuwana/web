---
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
import Layout from "../layouts/Layout.astro";

// URL Google Apps Script Web App (Katalog & Kalkulator P3K)
const SCRIPT_URL = "https://script.google.com/macros/s/AKfycbwQW2CXUVgC1y2JBjhs5WcNElpdnZQmY9g8Lds-QicBFDVIcxHhq62BXVPbI_oXcEA/exec";
---

<Layout title="Katalog & Panduan Stok P3K - KPA Trinawa Bhuwana SMAN 39">
  <main class="w-full pt-20 bg-surface flex flex-col min-h-screen">
    <!-- TOP BAR HEADER -->
    <section class="w-full py-6 px-4 md:px-8 lg:px-12 bg-surface border-b border-outline-variant/30">
      <div class="max-w-[1440px] mx-auto flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div>
          <!-- Breadcrumb -->
          <div class="flex items-center gap-2 mb-2">
            <a href={`${base}/`} class="text-xs text-on-surface-variant hover:text-primary transition-colors">Beranda</a>
            <span class="text-on-surface-variant/40 text-xs">/</span>
            <span class="text-xs text-on-surface-variant">App</span>
            <span class="text-on-surface-variant/40 text-xs">/</span>
            <span class="text-xs font-semibold text-primary">Katalog P3K</span>
          </div>

          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-red-500/15 text-red-600 flex items-center justify-center shrink-0">
              <span class="material-symbols-outlined text-[24px]">medical_services</span>
            </div>
            <div>
              <h1 class="text-xl sm:text-2xl font-extrabold uppercase text-on-surface tracking-tight leading-tight">
                Katalog &amp; Kalkulator Stok P3K
              </h1>
              <p class="text-xs text-on-surface-variant mt-0.5">
                Alat bantu penghitungan logistik medis lapangan KPA Trinawa Bhuwana SMAN 39 Jakarta
              </p>
            </div>
          </div>
        </div>

        <!-- Action / External link fallback -->
        <div class="flex items-center gap-2.5">
          <a
            href={SCRIPT_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-surface-container hover:bg-surface-container-high text-on-surface text-xs font-bold transition-all border border-outline-variant/40"
            title="Buka di tab terpisah"
          >
            <span>Buka Layar Penuh</span>
            <span class="material-symbols-outlined text-[16px]">open_in_new</span>
          </a>
        </div>
      </div>
    </section>

    <!-- EMBEDDED IFRAME CONTAINER -->
    <section class="flex-1 w-full bg-surface-container-lowest relative">
      <!-- Loading indicator while iframe is loading -->
      <div id="iframe-loader" class="absolute inset-0 flex flex-col items-center justify-center gap-3 bg-surface/80 backdrop-blur-sm z-10 transition-opacity duration-300">
        <div class="w-10 h-10 border-4 border-[#065143]/20 border-t-[#FF8000] rounded-full animate-spin"></div>
        <span class="text-xs font-semibold text-on-surface-variant">Memuat Aplikasi Katalog P3K...</span>
      </div>

      <iframe
        id="app-iframe"
        src={SCRIPT_URL}
        class="w-full h-[85vh] min-h-[700px] border-0"
        title="Katalog & Kalkulator P3K Trinawa Bhuwana"
        allow="fullscreen"
        loading="lazy"
        onload="document.getElementById('iframe-loader').classList.add('opacity-0', 'pointer-events-none'); setTimeout(() => document.getElementById('iframe-loader').remove(), 300);"
      ></iframe>
    </section>
  </main>
</Layout>
