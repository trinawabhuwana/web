---
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Dokumen Resmi Organisasi - KPA Trinawa Bhuwana SMAN 39 Jakarta">
  <main class="w-full pt-20 bg-surface min-h-screen">
    
    <!-- HERO HEADER -->
    <section class="relative w-full py-14 md:py-20 px-4 md:px-8 lg:px-12 bg-gradient-to-b from-[#065143]/15 via-surface to-surface overflow-hidden border-b border-outline-variant/30">
      <div class="absolute -top-24 -right-24 w-96 h-96 bg-[#065143]/10 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute -bottom-24 -left-24 w-96 h-96 bg-[#FF8000]/10 rounded-full blur-3xl pointer-events-none"></div>

      <div class="max-w-[1200px] mx-auto relative z-10 text-center flex flex-col items-center">
        <!-- Breadcrumb -->
        <div class="flex items-center gap-2 mb-4 text-xs text-on-surface-variant">
          <a href={`${base}/`} class="hover:text-primary transition-colors">Beranda</a>
          <span>/</span>
          <span class="text-primary font-bold">Dokumen Resmi</span>
        </div>

        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-secondary-fixed text-on-secondary-fixed text-xs font-semibold uppercase tracking-wider mb-3">
          <span class="material-symbols-outlined text-[16px]">verified</span>
          <span>Konstitusi, Aturan &amp; Etika Rimba</span>
        </div>

        <h1 class="text-3xl sm:text-4xl md:text-5xl font-black text-on-surface tracking-tight uppercase leading-tight font-display">
          Pusat Dokumen Resmi <br />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary via-tertiary to-secondary">
            KPA Trinawa Bhuwana
          </span>
        </h1>
        <p class="text-sm sm:text-base text-on-surface-variant max-w-2xl mt-3 leading-relaxed">
          Kumpulan pedoman landasan hukum, anggaran rumah tangga, kode etik, undang-undang organisasi, serta tata tertib kedisiplinan siswa-siswi SMAN 39 Jakarta.
        </p>

        <!-- Quick Access Navigation Pills -->
        <div class="mt-8 flex flex-wrap items-center justify-center gap-2 sm:gap-3 bg-surface-container-low p-2 rounded-2xl border border-outline-variant/30">
          <a href={`${base}/dokumen/kode-etik`} class="px-3.5 py-1.5 rounded-xl text-xs font-bold text-on-surface-variant hover:text-primary transition-colors">
            1. Kode Etik
          </a>
          <a href={`${base}/dokumen/undang-undang`} class="px-3.5 py-1.5 rounded-xl text-xs font-bold text-on-surface-variant hover:text-primary transition-colors">
            2. Undang-Undang
          </a>
          <a href={`${base}/dokumen/anggaran-rumah-tangga`} class="px-3.5 py-1.5 rounded-xl text-xs font-bold text-on-surface-variant hover:text-primary transition-colors">
            3. ART &amp; PDF Asli
          </a>
          <a href={`${base}/dokumen/tujuan-hakekat`} class="px-3.5 py-1.5 rounded-xl text-xs font-bold text-on-surface-variant hover:text-primary transition-colors">
            4. Tujuan &amp; Hakekat
          </a>
          <a href={`${base}/dokumen/tata-tertib`} class="px-3.5 py-1.5 rounded-xl text-xs font-bold text-on-surface-variant hover:text-primary transition-colors">
            5. Tata Tertib
          </a>
        </div>
      </div>
    </section>

    <!-- 5 MAIN DOCUMENT CARDS -->
    <section class="w-full py-16 md:py-24 px-4 md:px-8 lg:px-12 bg-surface">
      <div class="max-w-[1280px] mx-auto grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        
        <!-- CARD 1: KODE ETIK -->
        <div class="bg-surface-container-lowest p-8 rounded-3xl border border-outline-variant/30 shadow-sm hover:shadow-xl hover:border-primary/40 transition-all flex flex-col justify-between group">
          <div>
            <div class="w-14 h-14 rounded-2xl bg-primary/10 text-primary flex items-center justify-center mb-5 group-hover:scale-110 transition-transform">
              <span class="material-symbols-outlined text-[30px]">nature_people</span>
            </div>
            <span class="text-[10px] font-black uppercase tracking-wider text-primary bg-primary/10 px-2.5 py-1 rounded-md">
              Dokumen 01
            </span>
            <h3 class="text-xl font-black text-on-surface uppercase tracking-tight mt-3 mb-2">
              Kode Etik Pecinta Alam Indonesia
            </h3>
            <p class="text-xs sm:text-sm text-on-surface-variant leading-relaxed mb-6">
              Ikrar luhur pengabdian kepada Tuhan, bangsa, tanah air, dan tanggung jawab pelestarian alam hasil kesepakatan Gladian Nasional IV Ujung Pandang 1974.
            </p>
          </div>
          <a
            href={`${base}/dokumen/kode-etik`}
            class="inline-flex items-center gap-2 text-xs font-black uppercase tracking-wider text-primary group-hover:text-primary-container transition-colors"
          >
            <span>Buka Kode Etik</span>
            <span class="material-symbols-outlined text-[16px] transition-transform group-hover:translate-x-1">arrow_forward</span>
          </a>
        </div>

        <!-- CARD 2: UNDANG-UNDANG -->
        <div class="bg-surface-container-lowest p-8 rounded-3xl border border-outline-variant/30 shadow-sm hover:shadow-xl hover:border-primary/40 transition-all flex flex-col justify-between group">
          <div>
            <div class="w-14 h-14 rounded-2xl bg-secondary-fixed text-on-secondary-fixed flex items-center justify-center mb-5 group-hover:scale-110 transition-transform">
              <span class="material-symbols-outlined text-[30px]">gavel</span>
            </div>
            <span class="text-[10px] font-black uppercase tracking-wider text-secondary bg-secondary/10 px-2.5 py-1 rounded-md">
              Dokumen 02
            </span>
            <h3 class="text-xl font-black text-on-surface uppercase tracking-tight mt-3 mb-2">
              Undang-Undang Trinawa Bhuwana
            </h3>
            <p class="text-xs sm:text-sm text-on-surface-variant leading-relaxed mb-6">
              Pasal 1 s.d. 8 yang mengatur status organisasi, syarat pengurus, syarat keanggotaan, hak dan kewajiban anggota biasa &amp; luar biasa, serta aturan ekspedisi.
            </p>
          </div>
          <a
            href={`${base}/dokumen/undang-undang`}
            class="inline-flex items-center gap-2 text-xs font-black uppercase tracking-wider text-primary group-hover:text-primary-container transition-colors"
          >
            <span>Buka Undang-Undang</span>
            <span class="material-symbols-outlined text-[16px] transition-transform group-hover:translate-x-1">arrow_forward</span>
          </a>
        </div>

        <!-- CARD 3: ANGGARAN RUMAH TANGGA & EMBED PDF -->
        <div class="bg-surface-container-lowest p-8 rounded-3xl border border-outline-variant/30 shadow-sm hover:shadow-xl hover:border-primary/40 transition-all flex flex-col justify-between group">
          <div>
            <div class="w-14 h-14 rounded-2xl bg-emerald-500/15 text-emerald-700 flex items-center justify-center mb-5 group-hover:scale-110 transition-transform">
              <span class="material-symbols-outlined text-[30px]">description</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-[10px] font-black uppercase tracking-wider text-emerald-700 bg-emerald-500/15 px-2.5 py-1 rounded-md">
                Dokumen 03
              </span>
              <span class="text-[10px] font-black uppercase tracking-wider text-[#FF8000] bg-[#FF8000]/15 px-2.5 py-1 rounded-md">
                PDF Asli Tersemat
              </span>
            </div>
            <h3 class="text-xl font-black text-on-surface uppercase tracking-tight mt-3 mb-2">
              Anggaran Rumah Tangga (ART)
            </h3>
            <p class="text-xs sm:text-sm text-on-surface-variant leading-relaxed mb-6">
              Naskah otentik ART Bab I s.d. Bab VII yang disahkan sejak 28 Oktober 1985 oleh Kepala SMAN 39 Jakarta, lengkap dengan pratinjau dokumen PDF resmi.
            </p>
          </div>
          <a
            href={`${base}/dokumen/anggaran-rumah-tangga`}
            class="inline-flex items-center gap-2 text-xs font-black uppercase tracking-wider text-primary group-hover:text-primary-container transition-colors"
          >
            <span>Buka ART &amp; PDF Embed</span>
            <span class="material-symbols-outlined text-[16px] transition-transform group-hover:translate-x-1">arrow_forward</span>
          </a>
        </div>

        <!-- CARD 4: TUJUAN & HAKEKAT -->
        <div class="bg-surface-container-lowest p-8 rounded-3xl border border-outline-variant/30 shadow-sm hover:shadow-xl hover:border-primary/40 transition-all flex flex-col justify-between group">
          <div>
            <div class="w-14 h-14 rounded-2xl bg-amber-500/15 text-amber-700 flex items-center justify-center mb-5 group-hover:scale-110 transition-transform">
              <span class="material-symbols-outlined text-[30px]">target</span>
            </div>
            <span class="text-[10px] font-black uppercase tracking-wider text-amber-700 bg-amber-500/15 px-2.5 py-1 rounded-md">
              Dokumen 04
            </span>
            <h3 class="text-xl font-black text-on-surface uppercase tracking-tight mt-3 mb-2">
              Tujuan &amp; Hakekat Organisasi
            </h3>
            <p class="text-xs sm:text-sm text-on-surface-variant leading-relaxed mb-6">
              Landasan filosofis 5 butir Hakekat Anggota dan 3 Tujuan Utama penempaan karakter: Disiplin, Tanggung Jawab, dan Persaudaraan erat.
            </p>
          </div>
          <a
            href={`${base}/dokumen/tujuan-hakekat`}
            class="inline-flex items-center gap-2 text-xs font-black uppercase tracking-wider text-primary group-hover:text-primary-container transition-colors"
          >
            <span>Buka Tujuan &amp; Hakekat</span>
            <span class="material-symbols-outlined text-[16px] transition-transform group-hover:translate-x-1">arrow_forward</span>
          </a>
        </div>

        <!-- CARD 5: TATA TERTIB -->
        <div class="bg-surface-container-lowest p-8 rounded-3xl border border-outline-variant/30 shadow-sm hover:shadow-xl hover:border-primary/40 transition-all flex flex-col justify-between group">
          <div>
            <div class="w-14 h-14 rounded-2xl bg-rose-500/15 text-rose-700 flex items-center justify-center mb-5 group-hover:scale-110 transition-transform">
              <span class="material-symbols-outlined text-[30px]">fact_check</span>
            </div>
            <span class="text-[10px] font-black uppercase tracking-wider text-rose-700 bg-rose-500/15 px-2.5 py-1 rounded-md">
              Dokumen 05
            </span>
            <h3 class="text-xl font-black text-on-surface uppercase tracking-tight mt-3 mb-2">
              Tata Tertib &amp; Kedisiplinan
            </h3>
            <p class="text-xs sm:text-sm text-on-surface-variant leading-relaxed mb-6">
              Pedoman kedisiplinan umum, tata tertib peserta didik (DIKSAR), aturan rapat musyawarah, serta tata tertib ekspedisi penjelajahan alam bebas.
            </p>
          </div>
          <a
            href={`${base}/dokumen/tata-tertib`}
            class="inline-flex items-center gap-2 text-xs font-black uppercase tracking-wider text-primary group-hover:text-primary-container transition-colors"
          >
            <span>Buka Tata Tertib</span>
            <span class="material-symbols-outlined text-[16px] transition-transform group-hover:translate-x-1">arrow_forward</span>
          </a>
        </div>

        <!-- CARD 6: DOWNLOAD REPOSITORY ARSIP -->
        <div class="bg-gradient-to-br from-[#065143] to-[#04342b] p-8 rounded-3xl text-white shadow-xl flex flex-col justify-between">
          <div>
            <div class="w-14 h-14 rounded-2xl bg-white/10 text-[#FF8000] flex items-center justify-center mb-5 border border-white/20">
              <span class="material-symbols-outlined text-[30px]">folder_zip</span>
            </div>
            <span class="text-[10px] font-black uppercase tracking-wider text-[#FF8000] bg-white/10 px-2.5 py-1 rounded-md">
              Arsip Cloud Resmi
            </span>
            <h3 class="text-xl font-black uppercase tracking-tight mt-3 mb-2">
              Unduh Buku Panduan Lengkap
            </h3>
            <p class="text-xs sm:text-sm text-white/80 leading-relaxed mb-6">
              Buku Panduan Pendidikan dan Latihan Trinawa Bhuwana format PDF asli (25 halaman lengkap dengan silabus &amp; kurikulum diklat).
            </p>
          </div>
          <a
            href="/documents/Buku_Panduan_Diklat_TNB.pdf"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl bg-[#FF8000] hover:bg-[#e07200] text-white text-xs font-black uppercase tracking-wider transition-all shadow-md"
          >
            <span class="material-symbols-outlined text-[18px]">download</span>
            <span>Unduh Dokumen PDF</span>
          </a>
        </div>

      </div>
    </section>

  </main>
</Layout>
