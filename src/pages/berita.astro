---
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
import Layout from "../layouts/Layout.astro";
import { allArticles } from "../data/articles";
import BannerSuburin from "../components/BannerSuburin.astro";

const categories = [
  { name: "Semua Kategori", slug: "all" },
  { name: "Zona Merinding", slug: "merinding" },
  { name: "Ekspedisi", slug: "ekspedisi" },
  { name: "Keterampilan Rimba", slug: "keterampilan" },
  { name: "Organisasi & Diksar", slug: "organisasi" },
  { name: "Konservasi", slug: "konservasi" },
];

// Highlight Headline (Artikel Paling Utama)
const headlineArticle = allArticles[0];
const otherArticles = allArticles.slice(1);
---

<Layout title="Berita & Artikel Rimba - KPA Trinawa Bhuwana SMAN 39 Jakarta">
  <main class="w-full pt-20 bg-surface min-h-screen">
    
    <!-- SECTION 1: HEADER & BREADCRUMB -->
    <section class="relative w-full py-12 md:py-16 px-4 md:px-8 lg:px-12 bg-surface overflow-hidden border-b border-outline-variant/30">
      <!-- Glow Accents -->
      <div class="absolute top-0 right-0 w-96 h-96 bg-primary/5 rounded-full blur-3xl pointer-events-none -mr-20 -mt-20"></div>
      <div class="absolute bottom-0 left-0 w-80 h-80 bg-secondary/5 rounded-full blur-2xl pointer-events-none -ml-16 -mb-16"></div>

      <div class="max-w-[1440px] mx-auto relative z-10">
        <!-- Breadcrumb -->
        <div class="flex items-center gap-2 mb-4">
          <a href={`${base}/`} class="text-xs text-on-surface-variant hover:text-primary transition-colors">Beranda</a>
          <span class="text-on-surface-variant/40 text-xs">/</span>
          <span class="text-xs font-semibold text-primary">Berita &amp; Artikel</span>
        </div>

        <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
          <div>
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary/10 border border-primary/25 text-primary text-xs font-bold uppercase tracking-wider mb-3">
              <span class="material-symbols-outlined text-[16px]">newspaper</span>
              <span>Pusat Publikasi &amp; Jurnal Lapangan</span>
            </div>
            <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-on-surface tracking-tight leading-tight uppercase">
              Warta &amp; Artikel <br class="hidden sm:inline" />
              <span class="text-primary font-bold">Trinawa Bhuwana</span>
            </h1>
            <p class="text-sm sm:text-base text-on-surface-variant max-w-2xl mt-2 leading-relaxed">
              Kumpulan dokumentasi resmi ekspedisi pegunungan, modul teknik hidup di alam bebas, warta regenerasi, dan aksi pelestarian lingkungan hidup SMAN 39 Jakarta.
            </p>
          </div>

          <!-- Quick Stats Pill -->
          <div class="flex items-center gap-3">
            <div class="px-4 py-3 bg-surface-container-low rounded-2xl border border-outline-variant/30 flex items-center gap-3 shadow-xs">
              <div class="w-10 h-10 rounded-xl bg-primary/15 text-primary flex items-center justify-center font-bold">
                <span class="material-symbols-outlined text-[20px]">auto_stories</span>
              </div>
              <div class="flex flex-col">
                <span class="text-xs uppercase font-bold text-on-surface-variant">Total Publikasi</span>
                <span class="text-lg font-black text-on-surface">{allArticles.length} Catatan</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 2: HEADLINE FEATURED STORY -->
    {headlineArticle && (
      <section class="w-full py-8 md:py-12 px-4 md:px-8 lg:px-12 bg-surface-container-lowest border-b border-outline-variant/20">
        <div class="max-w-[1440px] mx-auto">
          <div class="relative w-full rounded-3xl overflow-hidden bg-slate-900 border border-outline-variant/30 shadow-xl group">
            <div class="grid grid-cols-1 lg:grid-cols-12 items-center">
              
              <!-- Image Banner Left -->
              <div class="lg:col-span-7 h-[320px] sm:h-[420px] lg:h-[480px] w-full overflow-hidden relative">
                <img
                  src={headlineArticle.imgSrc}
                  alt={headlineArticle.imgAlt}
                  class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                />
                <div class="absolute inset-0 bg-gradient-to-t lg:bg-gradient-to-r from-black/80 via-black/30 to-transparent"></div>
                <div class="absolute top-4 left-4">
                  <span class="px-3.5 py-1.5 rounded-xl bg-primary text-white font-extrabold text-xs uppercase tracking-wider shadow-lg flex items-center gap-1.5">
                    <span class="material-symbols-outlined text-[16px]">star</span>
                    Laporan Sorotan Utama
                  </span>
                </div>
              </div>

              <!-- Content Right -->
              <div class="lg:col-span-5 p-6 sm:p-8 lg:p-10 flex flex-col justify-between gap-4 text-white">
                <div class="flex flex-col gap-3">
                  <div class="flex items-center gap-2 text-xs text-white/60">
                    <span class="text-[#FF8000] font-bold uppercase tracking-wider">{headlineArticle.category}</span>
                    <span>•</span>
                    <span>{headlineArticle.date}</span>
                    {headlineArticle.location && (
                      <>
                        <span>•</span>
                        <span class="flex items-center gap-0.5">
                          <span class="material-symbols-outlined text-[13px]">{headlineArticle.locationIcon || "pin_drop"}</span>
                          <span>{headlineArticle.location}</span>
                        </span>
                      </>
                    )}
                  </div>

                  <h2 class="text-xl sm:text-2xl lg:text-3xl font-extrabold uppercase leading-snug group-hover:text-[#FF8000] transition-colors">
                    {headlineArticle.title}
                  </h2>

                  <p class="text-xs sm:text-sm text-white/75 leading-relaxed">
                    {headlineArticle.desc}
                  </p>
                </div>

                <div class="pt-4 border-t border-white/10 flex items-center justify-between">
                  <div class="flex items-center gap-2 text-xs text-white/60">
                    <span class="material-symbols-outlined text-[16px] text-primary">person</span>
                    <span>{headlineArticle.author}</span>
                  </div>
                  <span class="text-xs text-white/50">{headlineArticle.readTime}</span>
                </div>
              </div>

            </div>
          </div>
        </div>
      </section>
    )}

    <!-- BANNER IKLAN LEADERBOARD SUBURIN -->
    <BannerSuburin variant="light" sourceContext="arsip-berita" className="!my-2" />

    <!-- SECTION 3: FILTER TABS & ARTICLES ARCHIVE -->
    <section class="w-full py-12 md:py-16 px-4 md:px-8 lg:px-12 bg-surface">
      <div class="max-w-[1440px] mx-auto flex flex-col gap-8">
        
        <!-- Filter Category Tabs -->
        <div class="flex flex-col sm:flex-row items-center justify-between gap-4 border-b border-outline-variant/30 pb-4">
          <div class="flex items-center gap-1.5 p-1 bg-surface-container rounded-2xl overflow-x-auto w-full sm:w-auto scrollbar-none" id="category-filter-tabs">
            {categories.map((cat, idx) => (
              <button
                type="button"
                data-category={cat.slug}
                class:list={[
                  "category-btn px-4 py-2 text-xs font-bold rounded-xl transition-all cursor-pointer whitespace-nowrap",
                  idx === 0
                    ? "bg-[#FF8000] text-white shadow-sm"
                    : "text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high",
                ]}
              >
                {cat.name}
              </button>
            ))}
          </div>

          <!-- Counter Label -->
          <span class="text-xs font-semibold text-on-surface-variant shrink-0" id="articles-count">
            Menampilkan {allArticles.length} Artikel
          </span>
        </div>

        <!-- Articles Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8" id="articles-grid">
          {allArticles.map((item) => (
            <a
              href={`/berita/${item.slug}`}
              id={item.id}
              data-category={item.categorySlug}
              class="article-card bg-surface-container-lowest rounded-3xl overflow-hidden border border-outline-variant/20 flex flex-col shadow-sm hover:shadow-xl hover:border-primary/40 transition-all duration-300 group cursor-pointer"
            >
              <!-- Card Image Banner -->
              <div class="relative w-full aspect-[16/10] overflow-hidden bg-black/10">
                <img
                  src={item.imgSrc}
                  alt={item.imgAlt}
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                  loading="lazy"
                />
                <div class="absolute top-3 left-3">
                  <span class={`font-label-caps text-[10px] font-black uppercase tracking-wider px-2.5 py-1 rounded-lg shadow-sm ${item.badgeClass}`}>
                    {item.badge}
                  </span>
                </div>
              </div>

              <!-- Card Body -->
              <div class="p-6 flex flex-col flex-1 justify-between gap-4">
                <div>
                  <div class="flex items-center gap-2 text-xs text-on-surface-variant mb-2">
                    <span class="font-bold text-primary">{item.category}</span>
                    <span>•</span>
                    <span>{item.date}</span>
                  </div>

                  <h3 class="text-base sm:text-lg font-extrabold uppercase text-on-surface group-hover:text-primary transition-colors leading-snug line-clamp-2">
                    {item.title}
                  </h3>

                  <p class="text-xs sm:text-sm text-on-surface-variant mt-2 leading-relaxed line-clamp-3">
                    {item.desc}
                  </p>
                </div>

                <!-- Footer with Author & Read Time -->
                <div class="pt-4 border-t border-outline-variant/20 flex items-center justify-between text-xs text-on-surface-variant">
                  <span class="font-medium truncate max-w-[180px]">{item.author}</span>
                  <span class="shrink-0 text-[11px] text-on-surface-variant/70 flex items-center gap-1 font-bold text-primary group-hover:underline">
                    <span>Baca</span>
                    <span class="material-symbols-outlined text-[14px]">arrow_forward</span>
                  </span>
                </div>
              </div>
            </a>
          ))}
        </div>

        <!-- Empty State if filter yields 0 -->
        <div id="no-articles" class="hidden py-16 text-center flex flex-col items-center justify-center gap-3">
          <div class="w-14 h-14 rounded-full bg-primary/10 text-primary flex items-center justify-center">
            <span class="material-symbols-outlined text-[28px]">search_off</span>
          </div>
          <span class="text-base font-bold text-on-surface">Tidak ada artikel di kategori ini</span>
          <p class="text-xs text-on-surface-variant">Silakan pilih kategori lainnya untuk membaca publikasi rimba.</p>
        </div>

      </div>
    </section>

    <!-- SECTION 3: CALL TO ACTION KIRIM NASKAH / TULISAN -->
    <section class="w-full py-12 px-4 md:px-8 lg:px-12 bg-surface-container-low border-t border-outline-variant/30">
      <div class="max-w-[1440px] mx-auto bg-gradient-to-br from-[#065143] to-[#04342b] rounded-3xl p-8 sm:p-10 text-white flex flex-col md:flex-row items-center justify-between gap-8 shadow-xl">
        <div class="flex flex-col max-w-2xl">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 text-[#FF8000] text-xs font-bold uppercase tracking-wider mb-2 w-fit">
            <span class="material-symbols-outlined text-[16px]">history_edu</span>
            <span>Ruang Kontributor Rimba</span>
          </div>
          <h3 class="text-2xl sm:text-3xl font-extrabold uppercase tracking-tight">
            Punya Catatan Pendakian atau Kisah Mistis Rimba?
          </h3>
          <p class="text-white/85 text-sm sm:text-base mt-2 leading-relaxed">
            Terbitkan artikel perjalanan, materi navigasi, atau cerita Zona Merinding Anda di website resmi KPA Trinawa Bhuwana SMAN 39. Tulis di Google Docs lengkap dengan foto, lalu kirimkan tautannya ke redaksi.
          </p>
        </div>

        <div class="flex items-center gap-3 shrink-0 w-full md:w-auto">
          <button
            type="button"
            class="btn-open-kirim-naskah w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-[#FF8000] hover:bg-[#e07200] text-white font-extrabold text-xs uppercase tracking-wider transition-all shadow-lg shadow-black/20 cursor-pointer active:scale-95"
          >
            <span class="material-symbols-outlined text-[18px]">edit_document</span>
            <span>Petunjuk &amp; Kirim Naskah</span>
          </button>
        </div>
      </div>
    </section>

  </main>
</Layout>

<script>
  function setupCategoryFilter() {
    const buttons = document.querySelectorAll(".category-btn");
    const cards = document.querySelectorAll(".article-card");
    const counter = document.getElementById("articles-count");
    const noArticles = document.getElementById("no-articles");

    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        // Toggle Active Button Styles
        buttons.forEach((b) => {
          b.classList.remove("bg-[#FF8000]", "text-white", "shadow-sm");
          b.classList.add("text-on-surface-variant");
        });
        btn.classList.add("bg-[#FF8000]", "text-white", "shadow-sm");
        btn.classList.remove("text-on-surface-variant");

        const targetCat = btn.getAttribute("data-category");
        let visibleCount = 0;

        cards.forEach((card) => {
          const cardCat = card.getAttribute("data-category");
          if (targetCat === "all" || targetCat === cardCat) {
            (card as HTMLElement).style.display = "flex";
            visibleCount++;
          } else {
            (card as HTMLElement).style.display = "none";
          }
        });

        // Update counter & empty state
        if (counter) {
          counter.textContent = `Menampilkan ${visibleCount} Artikel`;
        }
        if (noArticles) {
          if (visibleCount === 0) {
            noArticles.classList.remove("hidden");
          } else {
            noArticles.classList.add("hidden");
          }
        }
      });
    });
  }

  setupCategoryFilter();
  document.addEventListener("astro:page-load", setupCategoryFilter);
</script>
