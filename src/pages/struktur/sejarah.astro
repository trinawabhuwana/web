---
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
import Layout from "../../layouts/Layout.astro";

// Data 26 Pendiri Angkatan 1 - Kabut Perintis (1985)
const perintisList = [
  { no: 1, name: "Ahmad Fatoni", status: "Alm" },
  { no: 2, name: "Anna Yudiana", status: "" },
  { no: 3, name: "Boyke Febian", status: "Alm (Ketua TNB Ke-2)" },
  { no: 4, name: "Budhi Pranoto", status: "" },
  { no: 5, name: "Budi Ginting", status: "" },
  { no: 6, name: "Bugie Rinaldi", status: "" },
  { no: 7, name: "Endang Kadar W.", status: "" },
  { no: 8, name: "Heppy Yulianto", status: "" },
  { no: 9, name: "I Made Agung Alit", status: "" },
  { no: 10, name: "Jaka Budi Utama", status: "" },
  { no: 11, name: "M. Apri Parayogi", status: "" },
  { no: 12, name: "M. Honofi", status: "" },
  { no: 13, name: "M. Yudi", status: "" },
  { no: 14, name: "Priyo Nugroho", status: "" },
  { no: 15, name: "Purwo Irawan", status: "" },
  { no: 16, name: "Rubiyanto", status: "TNB 39017 KP (Inisiator & Pemateri)" },
  { no: 17, name: "Rudy Brata", status: "Alm" },
  { no: 18, name: "Rusmanto Baceng", status: "Alm" },
  { no: 19, name: "Sally Riana Dile", status: "" },
  { no: 20, name: "Suci Anton", status: "" },
  { no: 21, name: "Tresia Alfa (Yanti)", status: "" },
  { no: 22, name: "Tony Bako", status: "" },
  { no: 23, name: "Yani Samalo", status: "" },
  { no: 24, name: "Yeni Rustiani (Yeye)", status: "" },
  { no: 25, name: "Yudi Abrimantyo", status: "" },
  { no: 26, name: "Wahyu Bimantoro", status: "Ketua TNB Pertama" },
];

// Timeline Kronologis Berdirinya Trinawa Bhuwana
const milestones = [
  {
    year: "Awal 1980 - 1984",
    title: "Era Seksi Pencinta Alam OSIS & Peristiwa Jambore Cipelang",
    desc: "Awalnya kepecintaalaman di SMAN 39 berada di bawah sub-seksi Olahraga OSIS. Pada Jambore ke-4 & Baksos di Cipelang Sukabumi (21-24 Mei 1984) yang diikuti 350 pelajar, terjadi insiden hipotermia massal saat diguyur hujan lebat. Kejadian ini membuka mata pentingnya manajemen keselamatan dan P3K di alam bebas.",
    icon: "history",
    badge: "1980 - 1984",
  },
  {
    year: "Agustus 1985",
    title: "Gagasan Penjelajahan Rimba & Ekspedisi Gua Cilalai",
    desc: "Rubiyanto (siswa SMAN 39 yang telah menempuh Sekolah Pendaki Gunung Wanadri Mandalawangi 1984) bersama 26 siswa lintas ekskul (PMR, KIR, OSIS, Paskibra, Pramuka) melakukan penelusuran ke Gua Cilalai Cileungsi. Perjalanan ini menjadi embrio berdirinya kelompok pecinta alam mandiri.",
    icon: "explore",
    badge: "Agustus 1985",
  },
  {
    year: "29 Agustus 1985",
    title: "Musyawarah di Ruang Kelas 3 Bahasa",
    desc: "Diadakan rapat pembentukan organisasi baru, penyusunan Anggaran Rumah Tangga (ART), serta perintisan kegiatan alam bebas yang terarah dan berorientasi keselamatan (safety procedure).",
    icon: "groups",
    badge: "29 Agustus 1985",
  },
  {
    year: "12 - 18 Oktober 1985",
    title: "Proposal Resmi, Pengesahan Kepala Sekolah & Pemberian Nama",
    desc: "Proposal diajukan ke Kepala Sekolah (Drs. Abdul Gafar). Bapak Ragil Sugiarto (Guru Bahasa Indonesia) menyempurnakan nama yang diusulkan oleh Rubiyanto menjadi TRINAWA BHUWANA, bermakna Tiga Sembilan di Jagat Raya sebagai wadah berlatih fisik, mental, dan keilmuan rimba.",
    icon: "verified",
    badge: "Oktober 1985",
  },
  {
    year: "Sabtu, 26 Oktober 1985",
    title: "Long March Solo Malam & Pengukuhan Hari Jadi",
    desc: "26 siswa perintis sepakat melakukan jalan malam solo (sendiri) dari kediaman masing-masing menuju Buperta Cibubur tanpa pembina. Perjalanan ini mengukuhkan hari lahir Trinawa Bhuwana dengan angkatan pertama: Kabut Perintis (KP), dipimpin Wahyu Bimantoro sebagai Ketua TNB Pertama.",
    icon: "nights_stay",
    badge: "26 Oktober 1985",
  },
  {
    year: "Senin, 28 Oktober 1985",
    title: "Pengumuman Resmi Sumpah Pemuda & SOP Lapangan",
    desc: "Bertepatan dengan Upacara Hari Sumpah Pemuda, Kepala Sekolah secara resmi mengumumkan keberadaan KPA Trinawa Bhuwana SMAN 39 Jakarta. Mulai 3 November 1985 diberlakukan protokol ketat: cek kesehatan dokter, tes fisik di Stadion Kopassus Cijantung, dan izin tertulis orang tua.",
    icon: "flag",
    badge: "28 Oktober 1985",
  },
];
---

<Layout title="Sejarah Berdirinya KPA Trinawa Bhuwana - SMAN 39 Jakarta">
  <main class="w-full pt-20 bg-surface min-h-screen">
    
    <!-- HERO HEADER -->
    <section class="relative w-full py-14 md:py-20 px-4 md:px-8 lg:px-12 bg-gradient-to-b from-[#065143]/15 via-surface to-surface overflow-hidden border-b border-outline-variant/30">
      <div class="absolute -top-24 -right-24 w-96 h-96 bg-[#065143]/10 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute -bottom-24 -left-24 w-96 h-96 bg-[#FF8000]/10 rounded-full blur-3xl pointer-events-none"></div>

      <div class="max-w-[1200px] mx-auto relative z-10 text-center flex flex-col items-center">
        <!-- Breadcrumb -->
        <div class="flex items-center gap-2 mb-4 text-xs text-on-surface-variant">
          <a href={`${base}/`} class="hover:text-primary transition-colors">Beranda</a>
          <span>/</span>
          <a href={`${base}/struktur`} class="hover:text-primary transition-colors">Struktur</a>
          <span>/</span>
          <span class="text-primary font-bold">Sejarah Organisasi</span>
        </div>

        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-secondary-fixed text-on-secondary-fixed text-xs font-semibold uppercase tracking-wider mb-3">
          <span class="material-symbols-outlined text-[16px]">menu_book</span>
          <span>Babad &amp; Kilas Balik 1985</span>
        </div>

        <h1 class="text-3xl sm:text-4xl md:text-5xl font-black text-on-surface tracking-tight uppercase leading-tight font-display">
          Sejarah Berdirinya <br />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary via-tertiary to-secondary">
            KPA Trinawa Bhuwana
          </span>
        </h1>
        <p class="text-sm sm:text-base text-on-surface-variant max-w-2xl mt-3 leading-relaxed">
          Catatan autentik perjalanan perintisan, lahirnya nama Trinawa Bhuwana, hingga pembentukan karakter persaudaraan rimba siswa-siswi SMAN 39 Jakarta sejak 1985.
        </p>

        <!-- Sub Navigation Pill -->
        <div class="mt-8 flex items-center gap-3 bg-surface-container-low p-1.5 rounded-2xl border border-outline-variant/30">
          <a
            href={`${base}/struktur`}
            class="px-4 py-2 rounded-xl text-xs font-bold text-on-surface-variant hover:text-on-surface transition-colors"
          >
            Bagan Struktur
          </a>
          <a
            href={`${base}/struktur/sejarah`}
            class="px-4 py-2 rounded-xl text-xs font-bold bg-primary text-white shadow-xs"
          >
            Sejarah Organisasi
          </a>
          <a
            href={`${base}/struktur/logo`}
            class="px-4 py-2 rounded-xl text-xs font-bold text-on-surface-variant hover:text-on-surface transition-colors"
          >
            Makna Lambang Logo
          </a>
        </div>
      </div>
    </section>

    <!-- MOTTO BANNER -->
    <section class="w-full py-10 px-4 md:px-8 lg:px-12 bg-surface-container-low border-b border-outline-variant/30">
      <div class="max-w-[1080px] mx-auto bg-gradient-to-r from-[#065143] to-[#04342b] rounded-3xl p-8 sm:p-10 text-white flex flex-col md:flex-row items-center justify-between gap-6 shadow-xl">
        <div class="flex items-center gap-4">
          <div class="w-14 h-14 rounded-2xl bg-white/10 flex items-center justify-center shrink-0 border border-white/20">
            <span class="material-symbols-outlined text-[32px] text-[#FF8000]">flag</span>
          </div>
          <div>
            <span class="text-xs uppercase font-extrabold tracking-widest text-[#FF8000]">Semboyan Rimba Abadi</span>
            <h2 class="text-xl sm:text-2xl font-black uppercase mt-0.5 tracking-tight">
              "Kami Tidak Pernah Berpikir Bahwa Kegiatan Ini Akan Berakhir"
            </h2>
            <p class="text-xs text-white/80 mt-1">
              Dokumen materi pemaparan sejarah oleh Rubiyanto (TNB 39017 KP) &bull; Angkatan Kabut Perintis.
            </p>
          </div>
        </div>

        <a
          href={`${base}/struktur/logo`}
          class="shrink-0 px-5 py-3 rounded-xl bg-[#FF8000] hover:bg-[#e07200] text-white text-xs font-extrabold uppercase tracking-wider transition-all shadow-md flex items-center gap-2"
        >
          <span>Arti Lambang Logo</span>
          <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
        </a>
      </div>
    </section>

    <!-- TIMELINE CHRONOLOGY -->
    <section class="w-full py-16 md:py-24 px-4 md:px-8 lg:px-12 bg-surface">
      <div class="max-w-[1080px] mx-auto flex flex-col gap-12">
        <div class="text-center max-w-xl mx-auto">
          <span class="text-xs font-bold uppercase tracking-widest text-primary">Kronologi Jejak Langkah</span>
          <h2 class="text-2xl sm:text-3xl font-black text-on-surface uppercase tracking-tight mt-1">
            Lintasan Peristiwa Pembentukan
          </h2>
          <p class="text-xs sm:text-sm text-on-surface-variant mt-2">
            Dari sub-seksi olahraga OSIS hingga diresmikan sebagai organisasi kepecintaalaman berwibawa di SMAN 39 Jakarta.
          </p>
        </div>

        <div class="relative pl-6 sm:pl-10 border-l-2 border-primary/30 flex flex-col gap-10">
          {milestones.map((item) => (
            <div class="relative flex flex-col gap-2 group">
              <!-- Dot Indicator -->
              <div class="absolute -left-[31px] sm:-left-[47px] top-0 w-8 h-8 rounded-full bg-surface border-2 border-primary group-hover:border-[#FF8000] flex items-center justify-center transition-colors shadow-sm">
                <span class="material-symbols-outlined text-[16px] text-primary group-hover:text-[#FF8000] transition-colors">
                  {item.icon}
                </span>
              </div>

              <div class="bg-surface-container-lowest p-6 rounded-3xl border border-outline-variant/30 group-hover:border-primary/40 group-hover:shadow-lg transition-all">
                <div class="flex items-center justify-between gap-3 mb-2">
                  <span class="px-3 py-1 rounded-full bg-primary/10 text-primary text-[11px] font-black uppercase tracking-wider">
                    {item.badge}
                  </span>
                  <span class="text-xs font-bold text-on-surface-variant">{item.year}</span>
                </div>
                <h3 class="text-base sm:text-lg font-black text-on-surface uppercase tracking-tight">
                  {item.title}
                </h3>
                <p class="text-xs sm:text-sm text-on-surface-variant mt-2 leading-relaxed">
                  {item.desc}
                </p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ANGKATAN 1: 26 PERINTIS KABUT PERINTIS (1985) -->
    <section class="w-full py-16 md:py-20 px-4 md:px-8 lg:px-12 bg-surface-container-low border-t border-outline-variant/30">
      <div class="max-w-[1200px] mx-auto flex flex-col gap-10">
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
          <div>
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary/10 text-primary text-xs font-bold uppercase tracking-wider mb-2">
              <span class="material-symbols-outlined text-[16px]">military_tech</span>
              <span>Generasi Pertama (1985)</span>
            </div>
            <h2 class="text-2xl sm:text-3xl font-black text-on-surface uppercase tracking-tight">
              26 Tokoh Angkatan Kabut Perintis (KP)
            </h2>
            <p class="text-xs sm:text-sm text-on-surface-variant mt-1">
              Siswa perintis yang melakukan jalan malam solo menuju Buperta Cibubur pada 26 Oktober 1985.
            </p>
          </div>
          <a
            href={`${base}/silsilah`}
            class="text-xs font-bold text-primary hover:underline flex items-center gap-1 shrink-0"
          >
            <span>Lihat Silsilah 33 Generasi</span>
            <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
          </a>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
          {perintisList.map((person) => (
            <div class="bg-surface-container-lowest p-4 rounded-2xl border border-outline-variant/20 flex items-center gap-3.5 shadow-xs hover:border-primary/40 transition-colors">
              <div class="w-10 h-10 rounded-xl bg-primary/10 text-primary flex items-center justify-center font-black text-sm shrink-0">
                {person.no}
              </div>
              <div class="flex flex-col overflow-hidden">
                <span class="text-xs font-black text-on-surface uppercase truncate">
                  {person.name}
                </span>
                <span class="text-[11px] text-on-surface-variant truncate">
                  {person.status ? person.status : "Anggota Perintis 1985"}
                </span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- HAKEKAT & TUJUAN ORGANISASI -->
    <section class="w-full py-16 md:py-24 px-4 md:px-8 lg:px-12 bg-surface border-t border-outline-variant/30">
      <div class="max-w-[1200px] mx-auto grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- Hakekat -->
        <div class="bg-surface-container-lowest p-8 rounded-3xl border border-outline-variant/30 shadow-md flex flex-col justify-between">
          <div>
            <div class="w-12 h-12 rounded-2xl bg-primary/10 text-primary flex items-center justify-center mb-4">
              <span class="material-symbols-outlined text-[26px]">gavel</span>
            </div>
            <span class="text-xs uppercase font-extrabold text-primary tracking-wider">Undang-Undang TNB, Pasal 4 Ayat 2</span>
            <h3 class="text-xl font-black text-on-surface uppercase tracking-tight mt-1 mb-4">
              Hakekat Anggota
            </h3>
            <ol class="space-y-3 text-xs sm:text-sm text-on-surface-variant list-decimal list-inside leading-relaxed">
              <li>Percaya dan taqwa kepada Tuhan Yang Maha Esa.</li>
              <li>Mengabdi dan berbakti kepada nusa, bangsa, dan negara Republik Indonesia.</li>
              <li>Disiplin, berani, bertanggung jawab, dan suka bermusyawarah.</li>
              <li>Rela berkorban, cinta alam, dan tabah menghadapi rintangan.</li>
              <li>Setia, patuh, dan dapat dipercaya dalam ucapan maupun tindakan.</li>
            </ol>
          </div>
        </div>

        <!-- Tujuan -->
        <div class="bg-surface-container-lowest p-8 rounded-3xl border border-outline-variant/30 shadow-md flex flex-col justify-between">
          <div>
            <div class="w-12 h-12 rounded-2xl bg-secondary-fixed text-on-secondary-fixed flex items-center justify-center mb-4">
              <span class="material-symbols-outlined text-[26px]">target</span>
            </div>
            <span class="text-xs uppercase font-extrabold text-secondary tracking-wider">ART TNB, Bab III Pasal 7</span>
            <h3 class="text-xl font-black text-on-surface uppercase tracking-tight mt-1 mb-4">
              Tujuan Organisasi
            </h3>
            <ol class="space-y-3 text-xs sm:text-sm text-on-surface-variant list-decimal list-inside leading-relaxed">
              <li>Memperkuat rasa disiplin dan kecintaan kepada alam serta tanah air Indonesia sebagai bagian dari ciptaan Tuhan YME.</li>
              <li>Menanamkan rasa tanggung jawab dalam melaksanakan setiap tahapan kegiatan lapangan.</li>
              <li>Mempererat rasa persaudaraan dalam lingkungan masyarakat pada umumnya dan keluarga besar Trinawa Bhuwana pada khususnya.</li>
            </ol>
          </div>

          <div class="mt-8 pt-6 border-t border-outline-variant/20 flex items-center justify-around text-center">
            <div>
              <span class="text-[10px] uppercase font-bold text-on-surface-variant">Pilar 1</span>
              <p class="text-xs font-black uppercase text-primary">Disiplin</p>
            </div>
            <div class="w-px h-6 bg-outline-variant/40"></div>
            <div>
              <span class="text-[10px] uppercase font-bold text-on-surface-variant">Pilar 2</span>
              <p class="text-xs font-black uppercase text-secondary">Tanggung Jawab</p>
            </div>
            <div class="w-px h-6 bg-outline-variant/40"></div>
            <div>
              <span class="text-[10px] uppercase font-bold text-on-surface-variant">Pilar 3</span>
              <p class="text-xs font-black uppercase text-tertiary">Persaudaraan</p>
            </div>
          </div>
        </div>
      </div>
    </section>

  </main>
</Layout>
