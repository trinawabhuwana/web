---
import Layout from "../../layouts/Layout.astro";

// Unsur-unsur Makna Lambang Trinawa Bhuwana dari Dokumen Presentasi
const logoElements = [
  {
    title: "Mata Angin Delapan Penjuru",
    desc: "Melambangkan delapan penjuru arah mata angin. Mencerminkan keluasan orientasi dan penjelajahan rimba nusantara serta kemampuan navigasi yang tak pernah tersesat.",
    colorBadge: "bg-primary text-white",
    colorHex: "#065143",
    icon: "explore",
  },
  {
    title: "Simpul Tali Pada Setiap Ujung",
    desc: "Melambangkan suatu ikatan persaudaraan yang kokoh dan erat antar sesama anggota Trinawa Bhuwana serta keharmonisan dengan alam semesta.",
    colorBadge: "bg-[#FF8000] text-white",
    colorHex: "#FF8000",
    icon: "all_inclusive",
  },
  {
    title: "Warna Biru (Kanan Bawah & Kiri Atas)",
    desc: "Melambangkan keagungan gunung-gunung tinggi, lautan yang luas, dan langit bebas tak bertepi tempat para penjelajah menatap cakrawala.",
    colorBadge: "bg-blue-600 text-white",
    colorHex: "#2563EB",
    icon: "landscape",
  },
  {
    title: "Warna Hijau (Kiri Bawah & Kanan Atas)",
    desc: "Melambangkan daratan, rimba lebat, dan hutan tropis tempat menempa fisik, ketahanan mental, serta kepedulian terhadap kelestarian ekosistem alam.",
    colorBadge: "bg-emerald-600 text-white",
    colorHex: "#059669",
    icon: "forest",
  },
  {
    title: "Pita Bertuliskan TRINAWA BHUWANA",
    desc: "Trinawa berarti Tiga Sembilan (39), dan Bhuwana berarti Jagad atau Alam Semesta. Disimpulkan bermakna wadah Kelompok Pencinta Alam SMA Negeri 39 Jakarta yang berkiprah di jagat raya.",
    colorBadge: "bg-slate-800 text-white",
    colorHex: "#1E293B",
    icon: "bookmark",
  },
  {
    title: "Syal Oranye Penjelajah",
    desc: "Melambangkan identitas penjelajah rimba yang berani, dinamis, mudah terlihat dalam operasi penyelamatan (search and rescue), dan pantang menyerah.",
    colorBadge: "bg-[#FF8000] text-white",
    colorHex: "#FF8000",
    icon: "local_fire_department",
  },
];
---

<Layout title="Arti & Makna Lambang Logo - KPA Trinawa Bhuwana SMAN 39 Jakarta">
  <main class="w-full pt-20 bg-surface min-h-screen">
    
    <!-- HERO HEADER -->
    <section class="relative w-full py-14 md:py-20 px-4 md:px-8 lg:px-12 bg-gradient-to-b from-[#065143]/15 via-surface to-surface overflow-hidden border-b border-outline-variant/30">
      <div class="absolute -top-24 -right-24 w-96 h-96 bg-[#065143]/10 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute -bottom-24 -left-24 w-96 h-96 bg-[#FF8000]/10 rounded-full blur-3xl pointer-events-none"></div>

      <div class="max-w-[1200px] mx-auto relative z-10 text-center flex flex-col items-center">
        <!-- Breadcrumb -->
        <div class="flex items-center gap-2 mb-4 text-xs text-on-surface-variant">
          <a href="/" class="hover:text-primary transition-colors">Beranda</a>
          <span>/</span>
          <a href="/struktur" class="hover:text-primary transition-colors">Struktur</a>
          <span>/</span>
          <span class="text-primary font-bold">Makna Lambang Logo</span>
        </div>

        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-secondary-fixed text-on-secondary-fixed text-xs font-semibold uppercase tracking-wider mb-3">
          <span class="material-symbols-outlined text-[16px]">token</span>
          <span>Identitas &amp; Filosofi Visual</span>
        </div>

        <h1 class="text-3xl sm:text-4xl md:text-5xl font-black text-on-surface tracking-tight uppercase leading-tight font-display">
          Arti Lambang &amp; Filosofi <br />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary via-tertiary to-secondary">
            Logo Trinawa Bhuwana
          </span>
        </h1>
        <p class="text-sm sm:text-base text-on-surface-variant max-w-2xl mt-3 leading-relaxed">
          Kajian filosofis bentuk mata angin, ikatan simpul tali, pembagian spektrum warna biru-hijau, serta makna harfiah nama Trinawa Bhuwana SMAN 39 Jakarta sejak 1985.
        </p>

        <!-- Sub Navigation Pill -->
        <div class="mt-8 flex items-center gap-3 bg-surface-container-low p-1.5 rounded-2xl border border-outline-variant/30">
          <a
            href="/struktur"
            class="px-4 py-2 rounded-xl text-xs font-bold text-on-surface-variant hover:text-on-surface transition-colors"
          >
            Bagan Struktur
          </a>
          <a
            href="/struktur/sejarah"
            class="px-4 py-2 rounded-xl text-xs font-bold text-on-surface-variant hover:text-on-surface transition-colors"
          >
            Sejarah Organisasi
          </a>
          <a
            href="/struktur/logo"
            class="px-4 py-2 rounded-xl text-xs font-bold bg-primary text-white shadow-xs"
          >
            Makna Lambang Logo
          </a>
        </div>
      </div>
    </section>

    <!-- SECTION 1: LOGO SHOWCASE & ANATOMY -->
    <section class="w-full py-16 md:py-24 px-4 md:px-8 lg:px-12 bg-surface">
      <div class="max-w-[1200px] mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <!-- Left: Large Emblem Display Card -->
        <div class="lg:col-span-5 flex flex-col items-center justify-center p-8 sm:p-12 bg-surface-container-lowest rounded-3xl border border-outline-variant/30 shadow-xl relative overflow-hidden group">
          <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(6,81,67,0.08),transparent_70%)]"></div>
          
          <img
            src="/images/sejarah/logo-trinawa-hd.png"
            alt="Logo Trinawa Bhuwana SMAN 39 Jakarta"
            class="w-64 sm:w-72 h-auto object-contain drop-shadow-2xl transition-transform duration-500 group-hover:scale-105 relative z-10"
          />

          <div class="mt-8 text-center relative z-10">
            <h2 class="text-lg font-black uppercase text-on-surface tracking-wider">
              Trinawa Bhuwana
            </h2>
            <p class="text-xs font-bold text-[#FF8000] uppercase tracking-widest mt-1">
              "Tiga Sembilan di Jagat Raya"
            </p>
            <span class="inline-block text-[11px] text-on-surface-variant mt-2 px-3 py-1 rounded-full bg-surface-container-low border border-outline-variant/20">
              Didesain oleh Rubiyanto &amp; Ragil Sugiarto (1985)
            </span>
          </div>
        </div>

        <!-- Right: Meaning & Etymology -->
        <div class="lg:col-span-7 flex flex-col gap-6">
          <div class="bg-surface-container-lowest p-6 sm:p-8 rounded-3xl border border-outline-variant/30 shadow-sm flex flex-col gap-4">
            <span class="text-xs uppercase font-extrabold text-primary tracking-widest">Etimologi Bahasa Sanskerta</span>
            <h3 class="text-2xl font-black text-on-surface uppercase tracking-tight">
              Makna Harfiah TRINAWA BHUWANA
            </h3>
            
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 my-2">
              <div class="p-4 rounded-2xl bg-primary/10 border border-primary/20 flex flex-col">
                <span class="text-xs font-bold text-primary uppercase">Trinawa</span>
                <span class="text-lg font-black text-primary mt-1">Tri (3) + Nawa (9)</span>
                <p class="text-xs text-on-surface-variant mt-1 leading-relaxed">
                  Melambangkan identitas asal sekolah: <strong>SMAN 39 Jakarta</strong>.
                </p>
              </div>

              <div class="p-4 rounded-2xl bg-secondary-fixed border border-secondary/20 flex flex-col">
                <span class="text-xs font-bold text-secondary uppercase">Bhuwana</span>
                <span class="text-lg font-black text-secondary mt-1">Jagat / Alam Semesta</span>
                <p class="text-xs text-on-surface-variant mt-1 leading-relaxed">
                  Melambangkan jagad raya tempat berpetualang dan menjaga kelestarian bumi.
                </p>
              </div>
            </div>

            <p class="text-xs sm:text-sm text-on-surface-variant leading-relaxed">
              Maka disimpulkan bermakna: <strong>Kelompok Pencinta Alam SMA Negeri 39 Jakarta</strong> yang membekali fisik, mental, dan keilmuan siswanya untuk menjelajahi dan merawat jagat raya Indonesia.
            </p>
          </div>

          <!-- Deskripsi Bentuk Utama -->
          <div class="bg-gradient-to-br from-[#065143] to-[#04342b] p-6 sm:p-8 rounded-3xl text-white shadow-lg flex flex-col gap-2">
            <div class="flex items-center gap-2 text-[#FF8000] text-xs font-bold uppercase tracking-wider">
              <span class="material-symbols-outlined text-[18px]">navigation</span>
              <span>Bentuk Lambang Utama</span>
            </div>
            <p class="text-sm sm:text-base leading-relaxed text-white/95 font-medium">
              "Berbentuk mata angin dengan delapan penjuru arah dan disimpul tali pada setiap ujungnya. Warna kiri bawah dan kanan atas berwarna hijau, sedangkan warna kanan bawah dan kiri atas berwarna biru."
            </p>
            <span class="text-[11px] text-white/60 mt-2 font-mono">
              Sumber: Anggaran Rumah Tangga &amp; Dokumen Materi Pemaparan KPA Trinawa Bhuwana SMAN 39 Jakarta
            </span>
          </div>
        </div>

      </div>
    </section>

    <!-- SECTION 2: GRID RINCIAN 6 UNSUR FILOSOFI LAMBANG -->
    <section class="w-full py-16 md:py-24 px-4 md:px-8 lg:px-12 bg-surface-container-low border-t border-outline-variant/30">
      <div class="max-w-[1200px] mx-auto flex flex-col gap-12">
        <div class="text-center max-w-xl mx-auto">
          <span class="text-xs font-bold uppercase tracking-widest text-primary">Anatomi &amp; Simbolik</span>
          <h2 class="text-2xl sm:text-3xl font-black text-on-surface uppercase tracking-tight mt-1">
            Rincian Makna Unsur Lambang
          </h2>
          <p class="text-xs sm:text-sm text-on-surface-variant mt-2">
            Setiap garis, simpul, dan paduan warna memiliki makna mendalam bagi setiap anggota rimba.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {logoElements.map((elem) => (
            <div class="bg-surface-container-lowest p-6 rounded-3xl border border-outline-variant/30 shadow-sm hover:shadow-lg hover:border-primary/40 transition-all flex flex-col justify-between group">
              <div>
                <div class="w-12 h-12 rounded-2xl bg-surface-container-high flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
                  <span class="material-symbols-outlined text-[26px] text-primary">
                    {elem.icon}
                  </span>
                </div>
                <span class={`inline-block px-2.5 py-0.5 rounded-md text-[10px] font-black uppercase tracking-wider mb-2 ${elem.colorBadge}`}>
                  {elem.title.split(" ")[0]}
                </span>
                <h4 class="text-base font-black text-on-surface uppercase tracking-tight mb-2">
                  {elem.title}
                </h4>
                <p class="text-xs sm:text-sm text-on-surface-variant leading-relaxed">
                  {elem.desc}
                </p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- SECTION 3: BOTTOM NAVIGATION -->
    <section class="w-full py-12 px-4 md:px-8 lg:px-12 bg-surface border-t border-outline-variant/30">
      <div class="max-w-[1080px] mx-auto flex flex-col sm:flex-row items-center justify-between gap-4">
        <a
          href="/struktur/sejarah"
          class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-primary hover:underline"
        >
          <span class="material-symbols-outlined text-[16px]">arrow_back</span>
          <span>Baca Sejarah Berdirinya 1985</span>
        </a>

        <a
          href="/struktur"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-primary hover:bg-primary-container text-white text-xs font-bold uppercase tracking-wider transition-all shadow-md"
        >
          <span>Kembali ke Bagan Struktur</span>
          <span class="material-symbols-outlined text-[16px]">account_tree</span>
        </a>
      </div>
    </section>

  </main>
</Layout>
