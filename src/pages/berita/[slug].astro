---
import Layout from "../../layouts/Layout.astro";
import { allArticles } from "../../data/articles";
import BannerSuburin from "../../components/BannerSuburin.astro";
import AffiliateShowcase from "../../components/AffiliateShowcase.astro";

// Generate Static Paths untuk setiap artikel
export function getStaticPaths() {
  return allArticles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props;

// Artikel terkait (kategori yang sama, selain artikel ini)
const relatedArticles = allArticles
  .filter((item) => item.id !== article.id && item.categorySlug === article.categorySlug)
  .slice(0, 3);
---

<Layout
  title={`${article.title} - KPA Trinawa Bhuwana SMAN 39 Jakarta`}
  description={article.desc}
  image={article.imgSrc}
  type="article"
>
  <main class="w-full pt-20 bg-surface min-h-screen">
    
    <!-- SECTION 1: HEADER & BREADCRUMB -->
    <section class="relative w-full py-10 md:py-14 px-4 md:px-8 lg:px-12 bg-surface overflow-hidden border-b border-outline-variant/30">
      <div class="max-w-[1080px] mx-auto relative z-10">
        <!-- Breadcrumb -->
        <div class="flex items-center gap-2 mb-4 text-xs">
          <a href="/" class="text-on-surface-variant hover:text-primary transition-colors">Beranda</a>
          <span class="text-on-surface-variant/40">/</span>
          <a href="/berita" class="text-on-surface-variant hover:text-primary transition-colors">Berita &amp; Artikel</a>
          <span class="text-on-surface-variant/40">/</span>
          <span class="text-primary font-semibold truncate max-w-[240px] sm:max-w-none">{article.title}</span>
        </div>

        <!-- Category & Date Meta -->
        <div class="flex flex-wrap items-center gap-3 mb-3">
          <span class={`font-label-caps text-xs font-black uppercase tracking-wider px-3 py-1 rounded-full ${article.badgeClass} shadow-xs`}>
            {article.category}
          </span>
          <span class="text-xs text-on-surface-variant">•</span>
          <span class="text-xs text-on-surface-variant font-medium">{article.date}</span>
          {article.location && (
            <>
              <span class="text-xs text-on-surface-variant">•</span>
              <span class="flex items-center gap-1 text-xs text-on-surface-variant">
                <span class="material-symbols-outlined text-[15px] text-primary">
                  {article.locationIcon || "pin_drop"}
                </span>
                <span>{article.location}</span>
              </span>
            </>
          )}
          <span class="text-xs text-on-surface-variant">•</span>
          <span class="text-xs text-on-surface-variant flex items-center gap-1">
            <span class="material-symbols-outlined text-[15px]">schedule</span>
            <span>{article.readTime}</span>
          </span>
        </div>

        <!-- Article H1 -->
        <h1 class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-extrabold uppercase text-on-surface tracking-tight leading-tight">
          {article.title}
        </h1>

        <!-- Author Byline -->
        <div class="flex items-center gap-3 mt-6 pt-6 border-t border-outline-variant/20">
          <div class="w-10 h-10 rounded-full bg-primary/15 text-primary flex items-center justify-center font-bold">
            <span class="material-symbols-outlined text-[20px]">person</span>
          </div>
          <div class="flex flex-col">
            <span class="text-xs font-bold text-on-surface uppercase">{article.author}</span>
            <span class="text-[11px] text-on-surface-variant">Publikasi Resmi KPA Trinawa Bhuwana SMAN 39</span>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 2: HERO IMAGE -->
    <section class="w-full px-4 md:px-8 lg:px-12 py-8 bg-surface-container-lowest">
      <div class="max-w-[1080px] mx-auto">
        <div class="w-full aspect-[16/9] md:aspect-[21/9] rounded-3xl overflow-hidden bg-black/10 shadow-xl border border-outline-variant/20">
          <img
            src={article.imgSrc}
            alt={article.imgAlt}
            class="w-full h-full object-cover"
          />
        </div>
      </div>
    </section>

    <!-- SECTION 3: ARTICLE BODY CONTENT -->
    <section class="w-full px-4 md:px-8 lg:px-12 py-8 bg-surface">
      <div class="max-w-[800px] mx-auto">
        
        <!-- Rich Article Body HTML -->
        <div class="prose prose-slate max-w-none text-slate-800 text-[15px] sm:text-base leading-relaxed flex flex-col gap-5">
          {article.contentHtml ? (
            <div set:html={article.contentHtml} class="article-rendered-content flex flex-col gap-4 leading-relaxed" />
          ) : (
            <p>{article.desc}</p>
          )}
        </div>

        <!-- Share & Return Footer -->
        <div class="mt-12 pt-6 border-t border-outline-variant/30 flex flex-col sm:flex-row items-center justify-between gap-4">
          <a
            href="/berita"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-surface-container hover:bg-surface-container-high text-xs font-bold uppercase tracking-wider text-on-surface transition-all border border-outline-variant/30"
          >
            <span class="material-symbols-outlined text-[18px]">arrow_back</span>
            <span>Kembali ke Warta &amp; Artikel</span>
          </a>

          <!-- Share button -->
          <div class="flex items-center gap-2">
            <span class="text-xs font-bold text-on-surface-variant">Bagikan:</span>
            <a
              href={`https://api.whatsapp.com/send?text=${encodeURIComponent(article.title + ' - ')}`}
              target="_blank"
              rel="noopener noreferrer"
              class="w-9 h-9 rounded-xl bg-emerald-500/15 text-emerald-700 hover:bg-emerald-600 hover:text-white flex items-center justify-center transition-colors"
              title="Bagikan ke WhatsApp"
            >
              <span class="material-symbols-outlined text-[18px]">share</span>
            </a>
          </div>
        </div>

      </div>
    </section>

    <!-- SECTION REKOMENDASI PERLENGKAPAN RIMBA (AFFILIATE TOKOPEDIA, SHOPEE, TIKTOK) -->
    <section class="w-full px-4 md:px-8 lg:px-12 bg-surface">
      <div class="max-w-[1080px] mx-auto">
        <AffiliateShowcase
          title="Rekomendasi Perlengkapan Teruji"
          subtitle="Koleksi gear rimba standar ekspedisi untuk keamanan dan kenyamanan penjelajahan Anda."
        />
      </div>
    </section>

    <!-- BANNER IKLAN LEADERBOARD SUBURIN DI HALAMAN BACA ARTIKEL -->
    <BannerSuburin
      variant={article.categorySlug === "merinding" ? "dark" : "light"}
      sourceContext={article.categorySlug}
      className="!my-4"
    />

    <!-- SECTION 4: RELATED ARTICLES -->
    {relatedArticles.length > 0 && (
      <section class="w-full py-12 md:py-16 px-4 md:px-8 lg:px-12 bg-surface-container-low border-t border-outline-variant/30">
        <div class="max-w-[1080px] mx-auto flex flex-col gap-6">
          <div class="flex items-center justify-between">
            <h3 class="text-lg font-extrabold uppercase text-on-surface">
              Artikel Terkait Lainnya
            </h3>
            <a href="/berita" class="text-xs font-bold text-primary hover:underline">
              Lihat Semua →
            </a>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            {relatedArticles.map((item) => (
              <a
                href={`/berita/${item.slug}`}
                class="bg-surface-container-lowest rounded-2xl overflow-hidden border border-outline-variant/20 hover:border-primary/40 shadow-sm hover:shadow-md transition-all flex flex-col group"
              >
                <div class="aspect-[16/10] overflow-hidden bg-black/10">
                  <img
                    src={item.imgSrc}
                    alt={item.imgAlt}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                  />
                </div>
                <div class="p-4 flex flex-col gap-2">
                  <span class="text-[10px] font-bold uppercase text-primary">{item.category}</span>
                  <h4 class="text-xs font-bold text-on-surface group-hover:text-primary transition-colors line-clamp-2 leading-snug">
                    {item.title}
                  </h4>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

  </main>
</Layout>
