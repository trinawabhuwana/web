---
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
import Layout from "../layouts/Layout.astro";
import { allTestimonials } from "../data/testimonials";

const testimonials = allTestimonials;
---

<Layout title="Kumpulan Testimoni & Kata Alumni - KPA Trinawa Bhuwana SMAN 39 Jakarta">
  <main class="w-full pt-20 bg-surface min-h-screen">
    
    <!-- HERO HEADER -->
    <section class="relative w-full py-14 md:py-20 px-4 md:px-8 lg:px-12 bg-gradient-to-b from-[#065143]/15 via-surface to-surface overflow-hidden border-b border-outline-variant/30">
      <div class="absolute -top-24 -right-24 w-96 h-96 bg-[#065143]/10 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute -bottom-24 -left-24 w-96 h-96 bg-[#FF8000]/10 rounded-full blur-3xl pointer-events-none"></div>

      <div class="max-w-[1200px] mx-auto relative z-10 text-center flex flex-col items-center">
        <!-- Breadcrumb -->
        <div class="flex items-center gap-2 mb-4 text-xs text-on-surface-variant">
          <a href={`${base}/`} class="hover:text-primary transition-colors">Beranda</a>
          <span>/</span>
          <span class="text-primary font-bold">Kumpulan Testimoni</span>
        </div>

        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-secondary-fixed text-on-secondary-fixed text-xs font-semibold uppercase tracking-wider mb-3">
          <span class="material-symbols-outlined text-[16px]">format_quote</span>
          <span>Suara Persaudaraan Rimba</span>
        </div>

        <h1 class="text-3xl sm:text-4xl md:text-5xl font-black text-on-surface tracking-tight uppercase leading-tight font-display">
          Kata Mereka bareng <br />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary via-tertiary to-secondary">
            Trinawa Bhuwana
          </span>
        </h1>
        <p class="text-sm sm:text-base text-on-surface-variant max-w-2xl mt-3 leading-relaxed">
          Kumpulan kesan, wejangan rimba, dan kenangan berharga dari alumni 33 generasi KPA Trinawa Bhuwana SMAN 39 Jakarta yang terhubung langsung dari lembar sensus resmi.
        </p>

        <!-- CTA ke Sensus Alumni -->
        <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
          <a
            href={`${base}/silsilah#formulir`}
            class="inline-flex items-center gap-2 px-5 py-3 rounded-xl bg-primary hover:bg-primary-container text-on-primary text-xs font-bold uppercase tracking-wider transition-all shadow-md active:scale-95"
          >
            <span class="material-symbols-outlined text-[18px]">edit_note</span>
            <span>Tulis Testimoni Alumni</span>
          </a>
          <span class="text-xs text-on-surface-variant">
            Data diverifikasi &amp; tayang otomatis dengan status <strong>Sah</strong>.
          </span>
        </div>
      </div>
    </section>

    <!-- TESTIMONIALS GRID -->
    <section class="w-full py-12 md:py-16 px-4 md:px-8 lg:px-12 bg-surface">
      <div class="max-w-[1440px] mx-auto">
        
        {testimonials.length > 0 ? (
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
            {testimonials.map((item) => (
              <div class="flex flex-col p-6 sm:p-8 rounded-3xl bg-surface-container-lowest shadow-sm hover:shadow-xl relative border border-outline-variant/30 hover:border-primary/40 transition-all duration-300 group">
                <span class="material-symbols-outlined text-[40px] text-primary/30 group-hover:text-primary transition-colors mb-4">
                  format_quote
                </span>
                
                <p class="font-body-md text-on-surface leading-relaxed flex-1 mb-6 italic text-sm sm:text-base">
                  "{item.quote}"
                </p>

                <div class="flex items-center gap-3.5 pt-4 bg-surface-container-low/60 p-3 rounded-2xl border border-outline-variant/20">
                  {item.avatar ? (
                    <img
                      src={item.avatar}
                      alt={item.name}
                      class="w-12 h-12 rounded-full object-cover border-2 border-primary/30 shadow-xs shrink-0"
                      loading="lazy"
                    />
                  ) : (
                    <div class="w-12 h-12 rounded-full bg-primary/10 text-primary flex items-center justify-center font-bold text-sm shadow-xs border border-primary/20 shrink-0">
                      <span class="material-symbols-outlined text-[24px]">person</span>
                    </div>
                  )}
                  <div class="flex flex-col overflow-hidden">
                    <span class="font-title-md text-sm sm:text-base text-on-surface font-black uppercase truncate">
                      {item.name}
                    </span>
                    <span class="font-body-sm text-xs text-on-surface-variant font-medium leading-snug line-clamp-2">
                      {item.role}
                    </span>
                  </div>
                </div>
              </div>
            ))}
          </div>
        ) : (
          <div class="text-center py-16 flex flex-col items-center max-w-md mx-auto">
            <div class="w-16 h-16 rounded-2xl bg-surface-container-high flex items-center justify-center text-on-surface-variant mb-4">
              <span class="material-symbols-outlined text-[32px]">chat_bubble_outline</span>
            </div>
            <h3 class="text-lg font-black uppercase text-on-surface">Belum Ada Testimoni Terpublikasi</h3>
            <p class="text-xs text-on-surface-variant mt-1 leading-relaxed">
              Alumni dapat mengisi formulir sensus dan memberikan pesan atau kenangan untuk ditayangkan di halaman ini.
            </p>
            <a
              href={`${base}/silsilah#formulir`}
              class="mt-4 px-5 py-2.5 rounded-xl bg-primary text-on-primary font-bold text-xs uppercase tracking-wider"
            >
              Isi Sensus Sekarang
            </a>
          </div>
        )}

      </div>
    </section>

  </main>
</Layout>
