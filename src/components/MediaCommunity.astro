---
---

<section id="media" class="w-full py-space-2xl bg-surface">
  <div class="max-w-[1440px] mx-auto px-margin md:px-margin-tablet lg:px-margin-desktop">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-gutter-desktop items-center">
      <!-- Left: Multimedia Showcase Card -->
      <div class="lg:col-span-6 flex flex-col">
        <div class="p-space-lg bg-surface-container-high rounded-2xl relative overflow-hidden shadow-md border border-outline-variant/30">
          <div class="flex items-center justify-between mb-space-md">
            <div class="flex items-center gap-space-sm">
              <span
                class="material-symbols-outlined text-error text-[28px]"
                style="font-variation-settings: 'FILL' 1;"
              >
                play_circle
              </span>
              <span class="font-title-md text-title-md text-on-surface font-bold">
                Video Dokumenter Ekspedisi
              </span>
            </div>
            <span class="font-label-caps text-label-caps px-2.5 py-0.5 bg-surface-bright rounded-full text-on-surface-variant font-bold border border-outline-variant/30">
              HD 1080p
            </span>
          </div>

          <!-- Video Thumbnail Mockup -->
          <div class="relative w-full aspect-video rounded-xl overflow-hidden bg-on-surface group cursor-pointer shadow-inner">
            <img
              class="w-full h-full object-cover opacity-85 group-hover:opacity-95 transition-opacity duration-300"
              alt="Cinematic frame of mountain trekker silhouette walking over clouds at mount slamet summit caldera"
              src="https://lh3.googleusercontent.com/aida-public/AB6AXuDf4DWHp0c__rkqJcDMWIRBjPdglDKgIhbrn_T3IFC8Z5VmyTyFhkaIkuXffDv5kKn-EJy9HMP3q_f6ewFAQ24W6AXSOA0GHi9oBoFWyr5FVenrSJNsUvf23gZfaz-HyKz0WEjNtYO-wxSOu5pwZ9cyc9Xrg1aqB8Cito0K1048X9qWbkG-pw_S5nMztzFuTiK2p3apPmNJOL3A-UR43Jgz3fWfN1of7qPW7ZoDjXcs"
              loading="lazy"
            />

            <a
              class="absolute inset-0 flex items-center justify-center"
              href="https://www.youtube.com/@trinawabhuwana"
              rel="noopener noreferrer"
              target="_blank"
              aria-label="Tonton Dokumenter Ekspedisi di YouTube"
            >
              <div class="w-16 h-16 rounded-full bg-error/90 text-on-error flex items-center justify-center shadow-lg group-hover:scale-115 transition-transform duration-200">
                <span
                  class="material-symbols-outlined text-[36px]"
                  style="font-variation-settings: 'FILL' 1;"
                >
                  play_arrow
                </span>
              </div>
            </a>

            <div class="absolute bottom-3 left-3 right-3 flex items-center justify-between text-surface-bright text-xs">
              <span class="bg-black/60 px-2 py-0.5 rounded-md backdrop-blur-sm font-medium">
                Dokumenter Angkatan XXVIII
              </span>
              <span class="bg-black/60 px-2 py-0.5 rounded-md backdrop-blur-sm font-mono">
                18:42
              </span>
            </div>
          </div>

          <p class="font-body-sm text-black mt-space-md leading-relaxed">
            Simak perjalanan, suka-duka di jalur pendakian, dan komitmen
            konservasi adik-adik Trinawa Bhuwana lewat kanal resmi YouTube kami.
          </p>
        </div>
      </div>

      <!-- Right: Social Channels & School Link -->
      <div class="lg:col-span-6 flex flex-col justify-center">
        <div class="inline-flex items-center gap-space-xs text-secondary font-label-caps text-label-caps uppercase tracking-wider mb-space-xs font-bold">
          <span class="material-symbols-outlined text-[16px]">hub</span>
          <span>Jejaring Komunitas &amp; Almamater</span>
        </div>

        <h2 class="font-headline-lg text-headline-lg text-black tracking-tight mb-space-md font-extrabold uppercase">
          Vibe Keluarga Trinawa Bhuwana
        </h2>

        <p class="font-body-md text-black mb-space-lg leading-relaxed text-[14px]">
          Ikuti perjalanan harian kegiatan kami, arsip foto ekspedisi,
          pengumuman latihan gabungan, dan tetap terhubung dengan almamater
          tercinta SMAN 39 Cijantung.
        </p>

        <div class="flex flex-col gap-space-sm">
          <!-- Instagram Link Box -->
          <a
            class="flex items-center justify-between p-space-md rounded-xl bg-surface-container-low hover:bg-surface-container transition-all group border border-outline-variant/20 shadow-xs"
            href="https://www.instagram.com/trinawabhuwana/"
            rel="noopener noreferrer"
            target="_blank"
          >
            <div class="flex items-center gap-space-md">
              <div class="w-11 h-11 rounded-xl bg-surface-container-high flex items-center justify-center text-primary group-hover:bg-primary group-hover:text-on-primary transition-colors shadow-xs">
                <span class="material-symbols-outlined text-[24px]">
                  photo_camera
                </span>
              </div>
              <div class="flex flex-col">
                <span class="font-title-md text-title-md text-on-surface font-semibold">
                  Instagram Resmi
                </span>
                <span class="font-body-sm text-body-sm text-on-surface-variant">
                  @trinawabhuwana • Feed visual &amp; Story kegiatan
                </span>
              </div>
            </div>
            <span class="material-symbols-outlined text-on-surface-variant group-hover:translate-x-1 group-hover:text-primary transition-all">
              open_in_new
            </span>
          </a>

          <!-- YouTube Channel Link Box -->
          <a
            class="flex items-center justify-between p-space-md rounded-xl bg-surface-container-low hover:bg-surface-container transition-all group border border-outline-variant/20 shadow-xs"
            href="https://www.youtube.com/@trinawabhuwana"
            rel="noopener noreferrer"
            target="_blank"
          >
            <div class="flex items-center gap-space-md">
              <div class="w-11 h-11 rounded-xl bg-surface-container-high flex items-center justify-center text-error group-hover:bg-error group-hover:text-on-error transition-colors shadow-xs">
                <span
                  class="material-symbols-outlined text-[24px]"
                  style="font-variation-settings: 'FILL' 1;"
                >
                  smart_display
                </span>
              </div>
              <div class="flex flex-col">
                <span class="font-title-md text-title-md text-on-surface font-semibold">
                  YouTube Channel
                </span>
                <span class="font-body-sm text-body-sm text-on-surface-variant">
                  @trinawabhuwana • Video ekspedisi &amp; tutorial outdoor
                </span>
              </div>
            </div>
            <span class="material-symbols-outlined text-on-surface-variant group-hover:translate-x-1 group-hover:text-error transition-all">
              open_in_new
            </span>
          </a>

          <!-- Official School Portal -->
          <a
            class="flex items-center justify-between p-space-md rounded-xl bg-surface-container-low hover:bg-surface-container transition-all group border border-outline-variant/20 shadow-xs"
            href="http://sman39jkt.sch.id/"
            rel="noopener noreferrer"
            target="_blank"
          >
            <div class="flex items-center gap-space-md">
              <div class="w-11 h-11 rounded-xl bg-surface-container-high flex items-center justify-center text-secondary group-hover:bg-secondary group-hover:text-on-secondary transition-colors shadow-xs">
                <span class="material-symbols-outlined text-[24px]">
                  school
                </span>
              </div>
              <div class="flex flex-col">
                <span class="font-title-md text-title-md text-on-surface font-semibold">
                  Website SMAN 39 Jakarta
                </span>
                <span class="font-body-sm text-body-sm text-on-surface-variant">
                  sman39jkt.sch.id • Portal resmi sekolah
                </span>
              </div>
            </div>
            <span class="material-symbols-outlined text-on-surface-variant group-hover:translate-x-1 group-hover:text-secondary transition-all">
              open_in_new
            </span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
