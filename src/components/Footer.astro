---
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<footer id="kontak" class="w-full bg-[#111111] text-white border-t border-white/10 shadow-[0_1px_8px_rgba(0,0,0,0.2)]">
  <div class="max-w-[1440px] mx-auto px-margin md:px-margin-tablet lg:px-margin-desktop py-space-xl">
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-gutter-desktop">
      
      <!-- Brand & Mission Column -->
      <div class="lg:col-span-5 flex flex-col gap-space-sm">
        <div class="flex items-center gap-space-sm">
          <img
            alt="Trinawa Bhuwana Logo"
            class="h-10 w-auto object-contain"
            src={`${base}/images/logo-trinawa-bhuwana.png`}
          />
          <span class="font-title-md text-title-md !text-white text-white uppercase tracking-tight font-bold">
            KPA TRINAWA BHUWANA
          </span>
        </div>

        <p class="font-body-md !text-white text-white leading-relaxed">
          Wadah pembinaan kepecintaalaman, kepanduan rimba, konservasi alam, dan integritas persaudaraan siswa-siswi SMAN 39 Jakarta Timur sejak berdirinya.
        </p>

        <div class="flex items-center gap-space-xs mt-space-xs text-[#FF8000] font-semibold">
          <span class="material-symbols-outlined text-[20px] text-[#FF8000]">nature_people</span>
          <span class="font-label-caps text-label-caps uppercase tracking-wider !text-white text-white">
            KITA TIDAK PERNAH BERFIKIR KEGIATAN INI AKAN BERAKHIR
          </span>
        </div>
      </div>

      <!-- Secretariat Address Column -->
      <div class="lg:col-span-4 flex flex-col gap-space-sm">
        <span class="font-label-caps text-label-caps !text-white text-white uppercase tracking-wider font-bold">
          Sekretariat &amp; Layanan Kontak
        </span>

        <div class="flex items-start gap-space-sm">
          <span class="material-symbols-outlined text-[#FF8000] shrink-0 mt-0.5 text-[20px]">location_on</span>
          <p class="font-body-sm !text-white text-white leading-relaxed">
            <strong class="!text-white text-white">SMAN 39 Jakarta</strong><br />
            Jl. RA. Fadillah, RT.1/RW.1, Cijantung, Kec. Ps. Rebo, Kota Jakarta Timur, DKI Jakarta 13780
          </p>
        </div>

        <!-- Email & WhatsApp Kontak Cepat -->
        <div class="flex flex-col gap-2 mt-2 pt-2 border-t border-white/10">
          <a
            href="mailto:trianwabhuwana@gmail.com"
            class="inline-flex items-center gap-2 text-xs text-white/90 hover:text-[#FF8000] transition-colors"
          >
            <span class="material-symbols-outlined text-[17px] text-[#FF8000]">mail</span>
            <span>trianwabhuwana@gmail.com (Kirim Naskah / Kerjasama)</span>
          </a>

          <a
            href="https://api.whatsapp.com/send?phone=6281388838116&text=Halo%20Admin%20Trinawa%20Bhuwana%2C%20saya%20tertarik%20pesan%20Pupuk%20Organik%20Suburin."
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 text-xs text-white/90 hover:text-emerald-400 transition-colors"
          >
            <span class="material-symbols-outlined text-[17px] text-emerald-400">chat</span>
            <span>+62 813-8883-8116 (Pemesanan Suburin / WhatsApp)</span>
          </a>
        </div>

        <div class="flex items-center gap-space-sm mt-space-xs">
          <span class="material-symbols-outlined text-[#FF8000] text-[20px]">link</span>
          <a
            class="font-body-sm text-body-sm text-[#FF8000] hover:underline font-medium"
            href="http://sman39jkt.sch.id/"
            rel="noopener noreferrer"
            target="_blank"
          >
            sman39jkt.sch.id
          </a>
        </div>
      </div>

      <!-- Social Media & Contact Links -->
      <div class="lg:col-span-3 flex flex-col gap-space-sm">
        <span class="font-label-caps text-label-caps !text-white text-white uppercase tracking-wider font-bold">
          Kanal Media &amp; Jejaring
        </span>

        <div class="flex flex-col gap-space-xs">
          <a
            class="inline-flex items-center gap-space-sm font-body-sm text-body-sm !text-white text-white hover:text-[#FF8000] transition-colors py-1 group"
            href="https://www.instagram.com/trinawabhuwana/"
            rel="noopener noreferrer"
            target="_blank"
          >
            <span class="material-symbols-outlined text-[18px] text-[#FF8000]">photo_camera</span>
            <span class="group-hover:text-[#FF8000] transition-colors">@trinawabhuwana</span>
          </a>

          <a
            class="inline-flex items-center gap-space-sm font-body-sm text-body-sm !text-white text-white hover:text-[#FF8000] transition-colors py-1 group"
            href="https://www.youtube.com/@trinawabhuwana"
            rel="noopener noreferrer"
            target="_blank"
          >
            <span class="material-symbols-outlined text-[18px] text-[#FF8000]">smart_display</span>
            <span class="group-hover:text-[#FF8000] transition-colors">YouTube Channel</span>
          </a>

          <a
            class="inline-flex items-center gap-space-sm font-body-sm text-body-sm !text-white text-white hover:text-[#FF8000] transition-colors py-1 group"
            href="#berita"
          >
            <span class="material-symbols-outlined text-[18px] text-[#FF8000]">campaign</span>
            <span class="group-hover:text-[#FF8000] transition-colors">Informasi Diksar &amp; Ekspedisi</span>
          </a>
        </div>
      </div>

    </div>

    <!-- Bottom Copyright Row -->
    <div class="mt-space-xl pt-space-lg border-t border-white/10 flex flex-col sm:flex-row items-center justify-between gap-space-md text-center sm:text-left !text-white text-white">
      <span class="font-body-sm text-body-sm !text-white text-white">
        &copy; 2025 KPA Trinawa Bhuwana SMAN 39 Jakarta. Hak cipta dilindungi undang-undang.
      </span>
      <span class="font-label-caps text-label-caps !text-white text-white uppercase font-semibold">
        Built with Astro Framework &bull; Charm UI &bull; Tailwind CSS
      </span>
    </div>

  </div>
</footer>
