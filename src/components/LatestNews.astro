---
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
import { allArticles } from "../data/articles";

// Ambil Top 3 artikel teratas untuk ditampilkan di Beranda
const articles = allArticles.slice(0, 3);
---

<section id="berita" class="w-full py-space-2xl bg-surface-container-low border-b border-outline-variant/30">
  <div class="max-w-[1440px] mx-auto px-margin md:px-margin-tablet lg:px-margin-desktop">
    
    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-space-xl gap-space-md">
      <div class="flex flex-col max-w-xl">
        <span class="font-label-caps text-label-caps uppercase tracking-wider text-primary font-bold">
          Warta &amp; Jurnal Ekspedisi
        </span>
        <h2 class="font-headline-lg text-headline-lg text-black tracking-tight mt-space-xs font-extrabold uppercase">
          Catatan Langkah Rimba SMAN 39
        </h2>
        <p class="font-body-md text-black mt-space-xs text-[14px]">
          Dokumentasi operasional pendakian, materi latihan fisik, dan agenda kegiatan anggota aktif terkini.
        </p>
      </div>
      <a
        class="inline-flex items-center gap-space-xs text-primary font-bold text-sm hover:underline group"
        href={`${base}/berita`}
      >
        <span>Lihat Semua Warta &amp; Artikel</span>
        <span class="material-symbols-outlined text-[18px] transition-transform group-hover:translate-x-1">
          arrow_forward
        </span>
      </a>
    </div>

    <!-- News Grid: 3 Editorial Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-space-lg">
      {articles.map((item) => (
        <article class="bg-surface-container-lowest rounded-2xl overflow-hidden border border-outline-variant/20 flex flex-col shadow-sm hover:shadow-md transition-shadow group">
          <div class="relative w-full aspect-[16/10] overflow-hidden bg-black/10">
            <img
              alt={item.imgAlt}
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
              loading="lazy"
              src={item.imgSrc}
            />
            <div class="absolute top-space-sm left-space-sm">
              <span class={`font-label-caps text-[11px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-md shadow-sm ${item.badgeClass}`}>
                {item.badge}
              </span>
            </div>
          </div>
          <div class="p-space-lg flex flex-col flex-1 justify-between">
            <div>
              <div class="flex items-center gap-space-sm text-black mb-space-xs text-[12px]">
                <span class="font-medium text-black">{item.date}</span>
                {item.location && (
                  <>
                    <span class="text-black/40">•</span>
                    <span class="flex items-center gap-0.5 text-black">
                      <span class="material-symbols-outlined text-[14px] text-black">
                        {item.locationIcon || "pin_drop"}
                      </span>
                      <span>{item.location}</span>
                    </span>
                  </>
                )}
              </div>
              <h3 class="font-title-lg text-title-lg text-black group-hover:text-primary transition-colors line-clamp-2 leading-snug font-extrabold uppercase">
                {item.title}
              </h3>
              <p class="font-body-sm text-black mt-space-sm line-clamp-3 leading-relaxed text-[14px]">
                {item.desc}
              </p>
            </div>
            <div class="pt-space-md mt-space-md border-t border-outline-variant/20 flex items-center justify-between">
              <a
                class="inline-flex items-center gap-1.5 text-xs font-bold text-primary hover:text-primary-container transition-colors"
                href={`${base}/berita/${item.slug}`}
              >
                <span>Baca Selengkapnya</span>
                <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
              </a>
              <span class="text-[11px] text-black/60">{item.readTime}</span>
            </div>
          </div>
        </article>
      ))}
    </div>

  </div>
</section>
