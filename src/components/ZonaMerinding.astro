---
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
import { allArticles } from "../data/articles";

// Ambil cerita khusus Zona Merinding
const horrorStories = allArticles.filter(
  (a) =>
    a.categorySlug === "merinding" ||
    a.category?.toLowerCase().includes("merinding") ||
    a.category?.toLowerCase().includes("horor")
);

// Ambil maksimal 3 kisah untuk ditampilkan di Beranda
const stories = horrorStories.slice(0, 3);
---

<section
  id="zona-merinding"
  class="relative w-full py-20 md:py-28 bg-[#0d0101] text-white overflow-hidden border-y border-red-950/80"
>
  <!-- Ambient Spooky Atmospheric Layers -->
  <!-- 1. Dark Red Radial Glow Center -->
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_40%,rgba(185,28,28,0.22),transparent_70%)] pointer-events-none"></div>
  
  <!-- 2. Dark Vignette at edges -->
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,transparent_30%,#050000_90%)] pointer-events-none"></div>

  <!-- 3. Ambient Blood Red Light Accents -->
  <div class="absolute -top-32 -left-32 w-96 h-96 bg-red-600/10 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute -bottom-32 -right-32 w-96 h-96 bg-red-900/15 rounded-full blur-3xl pointer-events-none"></div>

  <!-- 4. Subtle Fog Lines Overlay -->
  <div class="absolute inset-0 opacity-15 bg-[repeating-linear-gradient(45deg,#000_0,#000_2px,transparent_0,transparent_8px)] pointer-events-none"></div>

  <div class="max-w-[1440px] mx-auto px-margin md:px-margin-tablet lg:px-margin-desktop relative z-10">
    
    <!-- Section Header (Spooky / Creepy Theme) -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-14 md:mb-16 gap-6 border-b border-red-950/80 pb-8">
      <div class="flex flex-col max-w-2xl">
        <!-- Spooky Badge -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-red-950/80 border border-red-600/40 text-red-400 text-xs font-black tracking-widest uppercase mb-3 w-fit shadow-[0_0_15px_rgba(220,38,38,0.3)]">
          <span class="material-symbols-outlined text-[16px] animate-pulse text-red-500">skull</span>
          <span>Zona Merinding &bull; Misteri Belantara</span>
        </div>

        <h2 class="text-3xl sm:text-4xl md:text-5xl font-black text-white tracking-tight uppercase font-display drop-shadow-[0_4px_12px_rgba(0,0,0,0.9)]">
          Cerita Mistis &amp; <span class="text-transparent bg-clip-text bg-gradient-to-r from-red-500 via-red-400 to-amber-600">Keheningan Rimba</span>
        </h2>
        <p class="text-slate-300/80 mt-3 text-sm sm:text-base leading-relaxed">
          Kisah nyata kejadian gaib, pantangan leluhur hutan, dan pengalaman astral anggota Trinawa Bhuwana di tapak pendakian nusantara.
        </p>
      </div>

      <!-- Call to Action / Arsip -->
      <div class="flex items-center gap-4">
        <a
          href={`${base}/berita?kategori=merinding`}
          class="inline-flex items-center gap-2 px-5 py-3 rounded-xl bg-gradient-to-r from-red-950 to-red-900 hover:from-red-900 hover:to-red-800 border border-red-700/50 text-white font-bold text-xs uppercase tracking-wider transition-all duration-300 shadow-[0_0_20px_rgba(185,28,28,0.3)] hover:shadow-[0_0_30px_rgba(220,38,38,0.5)] group"
        >
          <span>Buka Semua Cerita</span>
          <span class="material-symbols-outlined text-[16px] transition-transform group-hover:translate-x-1 text-red-400">
            arrow_forward
          </span>
        </a>
      </div>
    </div>

    <!-- Stories Grid: 3 Spooky Horror Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {stories.map((story) => (
        <article class="group relative flex flex-col bg-[#140202]/90 hover:bg-[#1a0303] rounded-2xl overflow-hidden border border-red-900/40 hover:border-red-600/60 shadow-[0_10px_30px_rgba(0,0,0,0.8)] hover:shadow-[0_10px_40px_rgba(220,38,38,0.25)] transition-all duration-300">
          
          <!-- Image Container with Spooky Red Overlay Filter -->
          <div class="relative w-full aspect-[16/10] overflow-hidden bg-black">
            <img
              src={story.imgSrc}
              alt={story.imgAlt}
              loading="lazy"
              class="w-full h-full object-cover grayscale contrast-125 brightness-75 group-hover:scale-105 group-hover:brightness-90 group-hover:contrast-100 transition-all duration-700"
            />
            
            <!-- Red Gradient Tint on Image -->
            <div class="absolute inset-0 bg-gradient-to-t from-[#140202] via-[#140202]/40 to-red-950/30 mix-blend-multiply"></div>
            <div class="absolute inset-0 bg-gradient-to-t from-[#140202] via-transparent to-transparent"></div>

            <!-- Top Tag Badge -->
            <div class="absolute top-3 left-3 flex items-center gap-2">
              <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-md text-[10px] font-black uppercase tracking-wider bg-red-950/90 text-red-300 border border-red-700/60 backdrop-blur-md shadow-lg">
                <span class="w-1.5 h-1.5 rounded-full bg-red-500 animate-ping"></span>
                {story.badge || "Misteri Hutan"}
              </span>
            </div>

            <!-- Reading Time pill -->
            <div class="absolute top-3 right-3">
              <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-md text-[10px] font-semibold bg-black/70 text-slate-300 backdrop-blur-xs border border-white/10">
                <span class="material-symbols-outlined text-[12px] text-red-400">schedule</span>
                {story.readTime}
              </span>
            </div>
          </div>

          <!-- Card Content Body -->
          <div class="p-6 flex flex-col flex-1 justify-between gap-5 relative">
            <div>
              <!-- Meta: Location & Date -->
              <div class="flex items-center gap-2 text-xs text-red-400/80 mb-2 font-medium">
                <span>{story.date}</span>
                {story.location && (
                  <>
                    <span class="text-red-900">•</span>
                    <span class="flex items-center gap-1 text-slate-400">
                      <span class="material-symbols-outlined text-[13px] text-red-500">
                        {story.locationIcon || "location_on"}
                      </span>
                      <span>{story.location}</span>
                    </span>
                  </>
                )}
              </div>

              <!-- Title -->
              <h3 class="text-lg font-black text-slate-100 group-hover:text-red-400 transition-colors leading-snug uppercase tracking-tight line-clamp-2">
                {story.title}
              </h3>

              <!-- Excerpt / Desc -->
              <p class="text-xs text-slate-400 mt-2.5 line-clamp-3 leading-relaxed font-normal">
                {story.desc}
              </p>
            </div>

            <!-- Card Bottom Action Link -->
            <div class="pt-4 border-t border-red-950/80 flex items-center justify-between">
              <div class="flex items-center gap-2 text-xs text-slate-400">
                <span class="material-symbols-outlined text-[15px] text-red-500">visibility</span>
                <span class="font-medium">{story.author}</span>
              </div>

              <a
                href={`/berita/${story.slug}`}
                class="inline-flex items-center gap-1 text-xs font-black uppercase tracking-wider text-red-400 hover:text-red-300 transition-colors group-hover:underline"
              >
                <span>Baca Kisah</span>
                <span class="material-symbols-outlined text-[14px] transition-transform group-hover:translate-x-1">
                  arrow_forward
                </span>
              </a>
            </div>

          </div>
        </article>
      ))}
    </div>

    <!-- Bottom Spooky Banner / Warning Rule -->
    <div class="mt-14 p-5 md:p-6 rounded-2xl bg-gradient-to-r from-red-950/60 via-black/80 to-red-950/60 border border-red-900/50 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="flex items-center gap-4">
        <div class="w-12 h-12 rounded-xl bg-red-900/30 border border-red-700/40 text-red-400 flex items-center justify-center shrink-0">
          <span class="material-symbols-outlined text-[24px]">nightlight</span>
        </div>
        <div>
          <h4 class="text-sm font-black uppercase text-red-200 tracking-wide">
            Punya Pengalaman Astral atau Cerita Mistis Pendakian?
          </h4>
          <p class="text-xs text-slate-400 mt-0.5">
            Tuliskan cerita di Google Docs lengkap dengan foto, lalu kirimkan link dokumen ke redaksi untuk kami terbitkan.
          </p>
        </div>
      </div>

      <div class="flex flex-wrap items-center gap-3 shrink-0">
        <button
          type="button"
          class="btn-open-kirim-naskah px-5 py-3 rounded-xl bg-gradient-to-r from-red-800 to-red-700 hover:from-red-700 hover:to-red-600 text-white text-xs font-black uppercase tracking-wider transition-all border border-red-500/50 flex items-center gap-2 shadow-[0_0_15px_rgba(220,38,38,0.4)] cursor-pointer active:scale-95"
        >
          <span class="material-symbols-outlined text-[16px]">edit_note</span>
          <span>Kirim Cerita Misteri</span>
        </button>
      </div>
    </div>

  </div>
</section>
