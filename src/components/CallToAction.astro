  <div class="max-w-[1440px] mx-auto px-margin md:px-margin-tablet lg:px-margin-desktop relative z-10 flex flex-col md:flex-row items-center justify-between gap-space-lg">
    
    <div class="flex flex-col max-w-2xl text-center md:text-left">
