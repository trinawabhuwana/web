---
interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: string;
}

const {
  title = "Trinawa Bhuwana - KPA SMAN 39 Jakarta",
  description = "Website Resmi Kelompok Pecinta Alam Trinawa Bhuwana SMAN 39 Jakarta. Wadah pembinaan kepecintaalaman, kepanduan rimba, konservasi alam, dan persaudaraan erat.",
  image = "/images/hero-ranukumbolo.jpg",
  type = "website",
} = Astro.props;

import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import KirimNaskahModal from "../components/KirimNaskahModal.astro";

// URL Canonikal Absolut untuk Open Graph (WhatsApp, Facebook, Twitter/X)
const canonicalURL = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.href;
const imageURL = image.startsWith("http")
  ? image
  : Astro.site
  ? new URL(image, Astro.site).href
  : image;
---

<!doctype html>
<html lang="id" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph Meta Tags (WhatsApp, Facebook, LinkedIn) -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="KPA Trinawa Bhuwana SMAN 39 Jakarta" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content="id_ID" />

    <!-- Twitter / X Card Meta Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />

    <!-- Google Tag Manager / Analytics -->
    <script async src="https://www.googletagmanager.com/gtm.js?id=GTM-M7CSB5PS"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
    </script>

    <!-- Google Fonts Preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    
    <!-- Google Fonts: Inter & Plus Jakarta Sans -->
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- Google Material Symbols Outlined -->
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-surface font-body-md text-on-surface antialiased min-h-screen flex flex-col selection:bg-[#FF8000] selection:text-black">
    <!-- Google Tag Manager (noscript) -->
    <noscript>
      <iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-M7CSB5PS"
        height="0"
        width="0"
        style="display:none;visibility:hidden"
      ></iframe>
    </noscript>

    <Header />
    <div class="flex-1">
      <slot />
    </div>
    <Footer />
    <KirimNaskahModal />
  </body>
</html>
